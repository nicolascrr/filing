---
/**
 * Teaser — US-10
 *
 * Full-width clickable image with centered overlay text. Breaks out of
 * `--content-max` (one of the explicitly full-width sections per AGENTS.md).
 * The entire component is a single link; the image is decorative (empty alt +
 * aria-hidden) since the accessible name comes from the title.
 *
 * Responsive (mobile-first): height scales down on mobile, text scales with
 * fluid typography tokens.
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { parseBold } from '../../i18n/t';

export interface Props {
  /** Centered overlay title (accessible name of the link). */
  title: string;
  /** Link target. */
  url: string;
  /** Full-width background image (decorative). */
  image: ImageMetadata;
  /** Optional layout override class. */
  class?: string;
  /** Desktop/tablet focal point for the decorative image. */
  objectPosition?: string;
  /** Mobile alignment inside the intentional contain matte. */
  mobileObjectPosition?: string;
  /** Home-only embroidered title reveal; other instances stay static. */
  animateTitle?: boolean;
  /** Slower home-page pacing without changing other opted-in instances. */
  titleRevealPace?: 'standard' | 'slow';
}

const {
  title,
  url,
  image,
  class: className,
  objectPosition = 'center center',
  mobileObjectPosition = objectPosition,
  animateTitle = false,
  titleRevealPace = 'standard',
} = Astro.props;
---

<a
  href={url}
  aria-label={title.replace(/\*\*/g, '')}
  data-teaser-title-reveal={animateTitle ? '' : undefined}
  data-teaser-title-pace={animateTitle ? titleRevealPace : undefined}
  class:list={[
    'teaser group relative block w-full overflow-hidden',
    'sm:h-[50vh] sm:min-h-[360px] md:h-[60vh]',
    className,
  ]}
  style={`--teaser-object-position: ${objectPosition}; --teaser-mobile-object-position: ${mobileObjectPosition}; --teaser-aspect-ratio: ${image.width} / ${image.height};`}
>
  <Image
    src={image}
    alt=""
    role="presentation"
    sizes="100vw"
    class="teaser__img"
    loading="lazy"
  />
  <!-- Dark scrim for text readability -->
  <div class="teaser__scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="absolute inset-0 flex items-center justify-center px-6">
    <h2
      class="teaser__title text-center text-white font-medium"
      style="font-size: var(--teaser-title-size, var(--text-3xl)); text-wrap: balance; letter-spacing: 0.02em;"
    >
      <span data-teaser-title-text set:html={parseBold(title)} />
    </h2>
  </div>
</a>

<style>
  .teaser__title {
    position: relative;
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 500;
    line-height: inherit;
    color: white;
    text-transform: uppercase;
  }

  .teaser[data-teaser-title-pace='slow'] {
    --teaser-title-size: calc(var(--text-3xl) * 1.2);
  }

  .teaser__img {
    /* Size the image to the frame, not its intrinsic ratio: the unlayered
       global image reset overrides Tailwind's layered height utilities. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: color-mix(in srgb, var(--color-charcoal) 94%, var(--color-brand-orange));
    object-position: var(--teaser-object-position);
    transform-origin: var(--teaser-object-position);
    transition: transform var(--duration-base) var(--ease-luxury);
  }

  @media (max-width: 639px) {
    .teaser {
      aspect-ratio: var(--teaser-aspect-ratio);
      min-height: 0;
      background:
        radial-gradient(circle at 50% 45%, rgba(244, 132, 8, 0.1), transparent 58%),
        var(--color-charcoal);
    }

    .teaser__img {
      object-fit: contain;
      object-position: var(--teaser-mobile-object-position);
      transform-origin: var(--teaser-mobile-object-position);
    }
  }

  .teaser__scrim {
    background: rgba(0, 0, 0, 0.35);
    transition: opacity var(--duration-base) var(--ease-luxury);
    opacity: 0.9;
  }

  .teaser:hover .teaser__img,
  .teaser:focus-visible .teaser__img {
    transform: scale(1.04);
  }

  .teaser:hover .teaser__scrim,
  .teaser:focus-visible .teaser__scrim {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .teaser__img,
    .teaser__scrim {
      transition: none;
    }
  }
</style>

<script>
  import { gsap, SplitText } from '../../scripts/gsap';
  import { getLanguageSwitchState } from '../../scripts/languageSwitchState';

  const cleanups: Array<() => void> = [];
  const cleanupTeasers = (): void => {
    cleanups.splice(0).forEach((cleanup) => cleanup());
  };

  function initTeasers(): void {
    cleanupTeasers();
    // Locale-only arrivals must not hide text in the restored viewport.
    if (
      getLanguageSwitchState() ||
      document.documentElement.dataset.suppressArrival === 'true' ||
      document.documentElement.dataset.languageSwitching === 'true'
    ) return;

    document.querySelectorAll<HTMLElement>('[data-teaser-title-reveal]').forEach((root) => {
      const text = root.querySelector<HTMLElement>('[data-teaser-title-text]');
      if (!text) return;
      const slow = root.dataset.teaserTitlePace === 'slow';
      const originalHTML = text.innerHTML;
      let presented = false;
      const media = gsap.matchMedia();
      media.add({
        motion: '(prefers-reduced-motion: no-preference)',
        mobile: slow ? '(max-width: 639px)' : 'not all',
      }, (matchContext) => {
        if (!matchContext.conditions?.motion || presented) return;
        const context = gsap.context(() => undefined, root);
        const state: { split: SplitText | null } = { split: null };
        try {
          context.add(() => {
            state.split = SplitText.create(text, {
              type: 'words,chars',
              aria: 'auto',
              autoSplit: true,
              onSplit(self) {
                return gsap.timeline({
                  scrollTrigger: {
                    trigger: root,
                    start: slow ? (matchContext.conditions?.mobile ? 'top 75%' : 'top 25%') : 'top 80%',
                    once: true,
                  },
                  onStart: () => { presented = true; },
                })
                  .from(self.chars, {
                    opacity: 0,
                    rotation: 5,
                    transformOrigin: '50% 75%',
                    duration: slow ? 2.2 : 1.2,
                    stagger: { amount: slow ? 0.8 : 0.35, from: 'center' },
                    ease: 'power2.out',
                  });
              },
            });
          });
        } catch (error) {
          context.revert();
          state.split?.revert();
          text.innerHTML = originalHTML;
          text.removeAttribute('aria-label');
          console.warn('Teaser title reveal unavailable; keeping static text.', error);
        }
        return () => {
          context.revert();
          state.split?.revert();
        };
      });
      cleanups.push(() => media.revert());
    });
  }

  document.addEventListener('astro:page-load', initTeasers);
  document.addEventListener('astro:before-swap', cleanupTeasers);
</script>
