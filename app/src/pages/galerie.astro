---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/PageHero.astro';
import BigCarousel from '../components/ui/BigCarousel.astro';
import SmallCarousel from '../components/ui/SmallCarousel.astro';
import CatalogueMasonry from '../components/ui/CatalogueMasonry.astro';
import { galleryManifest } from '../server/galleryCatalogue';
import pageHeroGalerie from '../assets/photos/hero/showroom-lead.jpg';

const t = Astro.locals.t;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const manifest = await galleryManifest(Astro.url.searchParams, Astro.locals.locale, t);
const strings = {
  overviewHeading: t('ui.gallery.overviewHeading'),
  reset: t('ui.gallery.reset'),
  emptyCoiling: t('ui.gallery.emptyCoiling'),
  sampleCount: t('ui.gallery.sampleCount'),
  imageCount: t('ui.gallery.imageCount'),
  viewCategory: t('ui.gallery.viewCategory'),
  zoomIn: t('ui.photo.zoomIn'),
  zoomOut: t('ui.photo.zoomOut'),
  resetZoom: t('ui.photo.reset'),
  previousSample: t('ui.photo.previousSample'),
  nextSample: t('ui.photo.nextSample'),
  loading: t('ui.photo.loading'),
  error: t('ui.photo.error'),
  retry: t('ui.photo.retry'),
  close: t('common.gallery.closeLabel'),
  prev: t('common.bigcarousel.prevLabel'),
  next: t('common.bigcarousel.nextLabel'),
  type: t('ui.gallery.type'),
  sample: t('ui.gallery.sample'),
};
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
const masonry = manifest.mode === 'overview' || manifest.cards.length >= 11;
const category = manifest.categories.find((c) => c.key === manifest.category);
---

<BaseLayout title={`${t('galerie.hero.title')} — ${t('common.brand.name')}`}>
  <Hero image={pageHeroGalerie} title={t('galerie.hero.title')} />
  <section
    class="content-max catalogue"
    data-gallery-root
    data-reveal-group
    data-reveal-start="top 80%"
    aria-label={t('galerie.selector.label')}
  >
    <nav class="catalogue-nav" aria-label={t('galerie.selector.label')}>
      <button type="button" data-gallery-reset aria-pressed={!category}
        >{t('ui.gallery.allCategories')}</button
      >
      {
        manifest.categories.map((c) => (
          <button
            type="button"
            data-gallery-category={c.key}
            aria-pressed={category?.key === c.key}
          >
            {c.label}
            <span>{c.typeCount}</span>
          </button>
        ))
      }
    </nav>
    <header class="catalogue-heading">
      <h2 data-gallery-heading data-reveal-title>{category?.label ?? strings.overviewHeading}</h2>
      <button type="button" data-gallery-reset>{strings.reset}</button>
    </header>
    <p data-gallery-status role="status" aria-live="polite">
      {category?.typeCount === 0 ? strings.emptyCoiling : ''}
    </p>
    <button type="button" data-gallery-retry hidden>{strings.retry}</button>
    <CatalogueMasonry cards={masonry ? manifest.cards : []} hidden={!masonry} />
    <SmallCarousel cards={!masonry ? manifest.cards : []} hidden={masonry} />
    <BigCarousel strings={strings} />
    <script is:inline type="application/json" data-gallery-manifest set:html={json(manifest)} />
    <script is:inline type="application/json" data-gallery-strings set:html={json(strings)} />
  </section>
</BaseLayout>

<style>
  .catalogue {
    max-width: 1800px;
    padding-block: var(--space-section);
  }
  .catalogue-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.8rem;
    padding-block: 1.5rem;
    border-block: 1px solid color-mix(in srgb, var(--color-charcoal) 18%, transparent);
  }
  .catalogue button {
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    cursor: pointer;
  }
  .catalogue-nav button {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    background: none;
    border: 0;
    color: var(--color-charcoal);
  }
  .catalogue-nav button span {
    font-size: 0.7rem;
    opacity: 0.55;
  }
  .catalogue-nav button[aria-pressed='true'] {
    color: var(--color-gold-text);
    box-shadow: inset 0 -1px var(--color-gold);
  }
  .catalogue-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block: 3rem 1rem;
  }
  .catalogue-heading h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    text-wrap: balance;
  }
  .catalogue-heading button {
    background: none;
    border: 1px solid color-mix(in srgb, var(--color-charcoal) 20%, transparent);
  }
  [data-gallery-status]:empty {
    display: none;
  }
  [data-gallery-status] {
    padding-block: 1rem;
  }
</style>
<script>
  import '../scripts/galleryController';
</script>
