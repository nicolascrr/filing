---
/** Skiper UI skiper19, adapted as the Home page's decorative background stroke. */
---

<div class="home-scroll-stroke-route">
  <svg
    class="home-scroll-stroke"
    data-home-scroll-stroke
    width="1278"
    height="2319"
    viewBox="0 0 1278 2319"
    fill="none"
    overflow="visible"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
  >
    <path
      data-home-thread-path
      d="M876.605 394.131C788.982 335.917 696.198 358.139 691.836 416.303C685.453 501.424 853.722 498.43 941.95 409.714C1016.1 335.156 1008.64 186.907 906.167 142.846C807.014 100.212 712.699 198.494 789.049 245.127C889.053 306.207 986.062 116.979 840.548 43.3233C743.932 -5.58141 678.027 57.1682 672.279 112.188C666.53 167.208 712.538 172.943 736.353 163.088C760.167 153.234 764.14 120.924 746.651 93.3868C717.461 47.4252 638.894 77.8642 601.018 116.979C568.164 150.908 557 201.079 576.467 246.924C593.342 286.664 630.24 310.55 671.68 302.614C756.114 286.446 729.747 206.546 681.86 186.442C630.54 164.898 492 209.318 495.026 287.644C496.837 334.494 518.402 366.466 582.455 367.287C680.013 368.538 771.538 299.456 898.634 292.434C1007.02 286.446 1192.67 309.384 1242.36 382.258C1266.99 418.39 1273.65 443.108 1247.75 474.477C1217.32 511.33 1149.4 511.259 1096.84 466.093C1044.29 420.928 1029.14 380.576 1033.97 324.172C1038.31 273.428 1069.55 228.986 1117.2 216.384C1152.2 207.128 1188.29 213.629 1194.45 245.127C1201.49 281.062 1132.22 280.104 1100.44 272.673C1065.32 264.464 1044.22 234.837 1032.77 201.413C1019.29 162.061 1029.71 131.126 1056.44 100.965C1086.19 67.4032 1143.96 54.5526 1175.78 86.1513C1207.02 117.17 1186.81 143.379 1156.22 166.691C1112.57 199.959 1052.57 186.238 999.784 155.164C957.312 130.164 899.171 63.7054 931.284 26.3214C952.068 2.12513 996.288 3.87363 1007.22 43.58C1018.15 83.2749 1003.56 122.644 975.969 163.376C948.377 204.107 907.272 255.122 913.558 321.045C919.727 385.734 990.968 497.068 1063.84 503.35C1111.46 507.456 1166.79 511.984 1175.68 464.527C1191.52 379.956 1101.26 334.985 1030.29 377.017C971.109 412.064 956.297 483.647 953.797 561.655C947.587 755.413 1197.56 941.828 936.039 1140.66C896.039 1171.074 870 1210 830 1238C790 1266 744 1285 700 1274C656 1263 626 1212 574 1189C522 1166 191.024 1126.394 134.536 1202.19C131.147 1206.738 136 1216 148 1218C160 1220 176 1218 181 1210C186 1202 190 1193 194 1192C198 1191 204.107318 1210.0128 196 1217C171.678046 1237.9616 8.532812 1364.645093 80 1460C151.467188 1555.354907 457.546797 1619.381227 720 1710C982.453203 1800.618773 1201.28 1917.83 1201.28 1997.83C1201.28 2077.83 977.94 2114.9275 700 2160C422.06 2205.0725 89.52 2258.12 24 2306C-41.52 2353.88 -54 2420 4 2412C56 2404 50 2347 7 2359C-31 2370 -38 2444 9 2458C58 2473 53 2539 3 2534C-45 2529 -41 2479 2 2487C43 2495 31 2590 0 2668.89"
      pathLength="1"
      stroke="var(--color-brand-orange)"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</div>

<style>
  .home-scroll-stroke-route {
    --home-thread-top-offset: calc(
      var(--space-section) + clamp(1.625rem, 3vw, 3rem) + clamp(1rem, 2vw, 2rem) +
        clamp(2rem, 4vw, 4rem)
    );

    position: absolute;
    display: none;
    z-index: var(--home-thread-decorative-layer, 0);
    inset: var(--home-thread-top-offset) 0 0;
    overflow: visible;
    pointer-events: none;
  }

  .home-scroll-stroke {
    position: absolute;
    /* Scale and shift the source geometry so its first and last path points
       align with the route wrapper's bounds. */
    top: -17.326275%;
    left: 82%;
    display: block;
    width: auto;
    height: 101.944865%;
    max-width: none;
    transform: translateX(-68.591941%);
  }

  @media (min-width: 640px) {
    .home-scroll-stroke-route {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-scroll-stroke-route {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from '../../../scripts/gsap';

  type Cleanup = () => void;

  const activeCleanups: Cleanup[] = [];

  function initHomeScrollStroke(): void {
    activeCleanups.splice(0).forEach((cleanup) => cleanup());

    const region = document.querySelector<HTMLElement>('[data-home-thread-region]');
    const end = document.querySelector<HTMLElement>('[data-home-thread-end]');
    const path = region?.querySelector<SVGPathElement>('[data-home-thread-path]');
    const svg = region?.querySelector<SVGSVGElement>('[data-home-scroll-stroke]');
    const route = svg?.closest<HTMLElement>('.home-scroll-stroke-route');
    const terminalContent = region?.querySelector<HTMLElement>(
      '[data-home-thread-terminal-content]',
    );
    const production = region?.querySelector<HTMLElement>(
      '.section-services a[href="/production"]',
    );
    if (!region || !end || !path || !svg || !route || !terminalContent || !production)
      return;

    const routeSource = path.getAttribute('d');
    if (!routeSource) return;

    const routePrefix = routeSource.split('C1201.28 2077.83')[0];
    if (!routePrefix) return;

    const draw = { pathLength: 0.5 };
    const measurePath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    const measure = (d: string): number => {
      measurePath.setAttribute('d', d);
      return measurePath.getTotalLength();
    };
    const prefixLength = measure(routePrefix);
    let oldMiddleLength = 0;
    let newMiddleLength = 0;
    let oldLength = prefixLength;
    let newLength = prefixLength;
    let middleTiming: ReadonlyArray<readonly [number, number]> = [];

    const middleDistance = (elapsed: number): number => {
      const time = Number.isFinite(elapsed)
        ? Math.max(0, Math.min(oldMiddleLength, elapsed))
        : 0;
      const linear = oldMiddleLength > 0 ? (time * newMiddleLength) / oldMiddleLength : 0;
      if (middleTiming.length < 2) return linear;
      let low = 0;
      let high = middleTiming.length - 1;
      while (high - low > 1) {
        const mid = (low + high) >>> 1;
        if (middleTiming[mid][0] <= time) low = mid;
        else high = mid;
      }
      const [t0, s0] = middleTiming[low];
      const [t1, s1] = middleTiming[high];
      const distance = s0 + ((time - t0) * (s1 - s0)) / (t1 - t0);
      return Number.isFinite(distance) ? distance : linear;
    };

    // Build an inverse time-density table at refresh, not while drawing. True
    // lobe passages get a constant slower speed; cosine shoulders avoid jumps.
    const updateMiddleTiming = (
      baselineLength: number,
      loops: ReadonlyArray<readonly [number, number]>,
    ): void => {
      middleTiming = [];
      if (![baselineLength, oldMiddleLength, newMiddleLength].every(
        (length) => Number.isFinite(length) && length > 0,
      )) return;
      const count = 2048;
      const step = newMiddleLength / count;
      const shoulder = Math.min(24, newMiddleLength / 100);
      const boundary = Math.min(80, newMiddleLength / 20);
      const weights = Array.from({ length: count + 1 }, (_, i) => {
        // Make the first/last interpolation intervals exactly unit-speed.
        if (i <= 1 || i >= count - 1) return { loop: 0, anchor: 1 };
        const s = i * step;
        let loop = 0;
        for (const [start, end] of loops) {
          const outside = Math.max(start - s, s - end, 0);
          if (outside < shoulder) {
            loop = Math.max(loop, (1 + Math.cos((Math.PI * outside) / shoulder)) / 2);
          }
        }
        const edge = Math.min(s, newMiddleLength - s);
        const anchor = edge < boundary
          ? (1 + Math.cos((Math.PI * edge) / boundary)) / 2
          : 0;
        return { loop, anchor };
      });
      let loopIntegral = 0;
      let anchorIntegral = 0;
      for (let i = 1; i <= count; i++) {
        loopIntegral += ((weights[i - 1].loop + weights[i].loop) * step) / 2;
        anchorIntegral += ((weights[i - 1].anchor + weights[i].anchor) * step) / 2;
      }
      const freeLength = newMiddleLength - loopIntegral - anchorIntegral;
      if (freeLength <= 0) return;
      const minimumDensity = oldMiddleLength / (1.7 * baselineLength);
      let loopDensity = 0;
      let linkDensity = 0;
      for (const beta of [0.75, 0.8]) {
        loopDensity = oldMiddleLength / (beta * baselineLength);
        linkDensity = (oldMiddleLength - loopDensity * loopIntegral - anchorIntegral) / freeLength;
        if (linkDensity >= minimumDensity) break;
      }
      if (!Number.isFinite(linkDensity) || linkDensity < minimumDensity) return;
      const density = weights.map(({ loop, anchor }) =>
        linkDensity + (loopDensity - linkDensity) * loop + (1 - linkDensity) * anchor,
      );
      if (density.some((value) => !Number.isFinite(value) || value <= 0)) return;
      const table: Array<readonly [number, number]> = [[0, 0]];
      let time = 0;
      for (let i = 1; i <= count; i++) {
        time += ((density[i - 1] + density[i]) * step) / 2;
        table.push([time, i * step]);
      }
      // The solved integral is Mref; pin its final sample against rounding drift.
      table[count] = [oldMiddleLength, newMiddleLength];
      middleTiming = table;
    };

    const render = (): void => {
      const originalDistance = (2 * draw.pathLength - 1) * oldLength;
      // Only the replacement middle absorbs its extra arc length. The original
      // curls keep both their reveal milestones and their arc-length velocity.
      let distance = originalDistance;
      if (originalDistance > prefixLength) {
        distance = originalDistance < prefixLength + oldMiddleLength
          ? prefixLength +
            middleDistance(originalDistance - prefixLength)
          : originalDistance + newMiddleLength - oldMiddleLength;
      }
      const dashParameter = (1 + distance / newLength) / 2;
      path.style.strokeDasharray = `${dashParameter} 1`;
      path.style.strokeDashoffset = String(1 - dashParameter);
    };

    // offset geometry deliberately ignores temporary reveal transforms on the
    // cards/copy. Convert its viewport coordinates through the SVG's real CTM.
    const layoutPosition = (element: HTMLElement): { x: number; y: number } => {
      let x = -window.scrollX;
      let y = -window.scrollY;
      let node: HTMLElement | null = element;
      while (node) {
        x += node.offsetLeft;
        y += node.offsetTop;
        node = node.offsetParent as HTMLElement | null;
      }
      return { x, y };
    };

    const updateTerminalRoute = (): void => {
      const svgBounds = svg.getBoundingClientRect();
      const matrix = svg.getScreenCTM();
      if (svgBounds.width === 0 || !matrix) return;
      const inverse = matrix.inverse();
      const contentPosition = layoutPosition(terminalContent);
      const productionPosition = layoutPosition(production);

      // Keep the terminal strand centered in the available whitespace to the
      // left of the ending copy, regardless of the tall SVG's responsive scale.
      const strokeWidth = (1 * svgBounds.width) / 1278;
      const targetViewportX = Math.max(strokeWidth / 2 + 8, contentPosition.x / 2);
      const terminalX = new DOMPoint(targetViewportX, contentPosition.y).matrixTransform(
        inverse,
      ).x;

      const terminalEntryX = terminalX + 24;

      const oldMiddle = `C1201.28 2077.83 ${terminalX + 977.94} 2114.9275 ${terminalX + 700} 2160C${terminalX + 422.06} 2205.0725 ${terminalX + 89.52} 2258.12 ${terminalEntryX} 2306`;
      const suffix = `C${terminalX - 41.52} 2353.88 ${terminalX - 54} 2420 ${terminalX + 4} 2412C${terminalX + 56} 2404 ${terminalX + 50} 2347 ${terminalX + 7} 2359C${terminalX - 31} 2370 ${terminalX - 38} 2444 ${terminalX + 9} 2458C${terminalX + 58} 2473 ${terminalX + 53} 2539 ${terminalX + 3} 2534C${terminalX - 45} 2529 ${terminalX - 41} 2479 ${terminalX + 2} 2487C${terminalX + 43} 2495 ${terminalX + 31} 2590 ${terminalX} 2668.89`;
      const cardBottom = productionPosition.y + production.offsetHeight;
      const gap = Math.max(0, contentPosition.y - cardBottom);
      const corridor = new DOMPoint(0, cardBottom + gap * 0.55).matrixTransform(
        inverse,
      ).y;
      const span = 1201.28 - terminalEntryX;
      const scale = Math.max(0.12, Math.min(1, (gap * inverse.d) / 200, span / 800));
      type Curve = readonly [number, number, number, number, number, number];
      // Exact terminal six cubics, relative to their entry (terminalX + 24, 2306).
      // Rotate +90 degrees in SVG coordinates: (x, y) -> (-y, x).
      const terminalCopy: ReadonlyArray<Curve> = [
        [-65.52, 47.88, -78, 114, -20, 106],
        [32, 98, 26, 41, -17, 53],
        [-55, 64, -62, 138, -15, 152],
        [34, 167, 29, 233, -21, 228],
        [-69, 223, -65, 173, -22, 181],
        [19, 189, 7, 284, -24, 362.89],
      ];
      const last = terminalCopy[terminalCopy.length - 1];
      const copyX = 1201.28 - span / 2 + (last[5] * scale) / 2;
      const copyY = corridor - (last[4] * scale) / 2;
      const point = (localX: number, localY: number): string =>
        `${copyX - localY * scale} ${copyY + localX * scale}`;
      const handle = 45 * scale;
      const entryX = copyX + 180 * scale;
      const first = terminalCopy[0];
      const copiedPair = terminalCopy.map((curve) =>
        `C${point(curve[0], curve[1])} ${point(curve[2], curve[3])} ${point(curve[4], curve[5])}`,
      ).join('');
      const pairExitControl = point(2 * last[4] - last[2], 2 * last[5] - last[3]);
      // Finish the horizontal return before descending beside (not across)
      // the paragraph, retaining the terminal entry's original C1 tangent.
      const turnX = terminalEntryX + 60;
      const descent = `C${turnX - 60} ${corridor} ${terminalX + 89.52} 2258.12 ${terminalEntryX} 2306`;
      // Measure the previously approved middle at this same responsive layout.
      const previousGuide = 1201.28 - 80 * scale;
      const previousExit = copyX - last[5] * scale - 180 * scale;
      const baselineMiddle = `C1201.28 2077.83 ${previousGuide + handle} ${corridor} ${previousGuide} ${corridor}C${previousGuide - handle} ${corridor} ${entryX + handle} ${corridor} ${entryX} ${corridor}C${entryX - handle} ${corridor} ${point(-first[0], -first[1])} ${point(0, 0)}${copiedPair}C${pairExitControl} ${previousExit + handle} ${corridor} ${previousExit} ${corridor}C${previousExit - handle} ${corridor} ${turnX + 60} ${corridor} ${turnX} ${corridor}${descent}`;
      const baselineLength = measure(`M1201.28 1997.83${baselineMiddle}`);

      const wave = Math.min(6, gap * 0.05) * inverse.d;
      // On narrow layouts the pair's leading tail already uses most of the
      // right-hand room. Keep the guide/control envelope progressing leftward.
      const guideOffset = Math.min(120 * scale, (1201.28 - entryX) * 0.6);
      const guideX = 1201.28 - guideOffset;
      const guideHandle = Math.min(60 * scale, guideOffset / 2, (guideX - entryX) / 3);
      const waveX = (guideX + entryX) / 2;
      const waveHandle = Math.min(handle, (guideX - entryX) / 6);
      const entryHandle = waveHandle;
      const rightWave = Math.min(wave, (guideX - entryX) / 4);
      let middle = `C1201.28 2077.83 ${guideX + guideHandle} ${corridor} ${guideX} ${corridor}`;
      middle += `C${guideX - guideHandle} ${corridor} ${waveX + waveHandle} ${corridor + rightWave} ${waveX} ${corridor + rightWave}`;
      middle += `C${waveX - waveHandle} ${corridor + rightWave} ${entryX + entryHandle} ${corridor} ${entryX} ${corridor}`;
      middle += `C${entryX - entryHandle} ${corridor} ${point(-first[0], -first[1])} ${point(0, 0)}`;
      const pairStart = measure(`M1201.28 1997.83${middle}`);
      // Isolate the middle lobe at its self-crossing, retaining its upward
      // entry direction in SVG coordinates and its exact original profile.
      const splitCurve = (index: number, t: number): readonly [Curve, Curve] => {
        const curve = terminalCopy[index];
        const previous = index === 0 ? [0, 0] : terminalCopy[index - 1].slice(4);
        const mix = (a: readonly number[], b: readonly number[]): number[] =>
          [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
        const a = mix(previous, curve.slice(0, 2));
        const b = mix(curve.slice(0, 2), curve.slice(2, 4));
        const c = mix(curve.slice(2, 4), curve.slice(4));
        const d = mix(a, b);
        const e = mix(b, c);
        const p = mix(d, e);
        return [
          [a[0], a[1], d[0], d[1], p[0], p[1]],
          [e[0], e[1], c[0], c[1], curve[4], curve[5]],
        ];
      };
      const [approach, lobeStart] = splitCurve(3, 0.7976340086318667);
      const [lobeEnd, departure] = splitCurve(5, 0.38656784004902905);
      const copiedCurve = (curve: Curve): string =>
        `C${point(curve[0], curve[1])} ${point(curve[2], curve[3])} ${point(curve[4], curve[5])}`;
      middle += terminalCopy.slice(0, 3).map(copiedCurve).join('');
      middle += copiedCurve(approach);
      const secondLoopStart = measure(`M1201.28 1997.83${middle}`);
      middle += [lobeStart, terminalCopy[4], lobeEnd].map(copiedCurve).join('');
      const secondLoopEnd = measure(`M1201.28 1997.83${middle}`);
      middle += copiedCurve(departure);

      // A single additional lobe: the first three unchanged terminal cubics.
      // Reserve room for both joining handles, shrinking only this whole copy.
      const pairEndX = copyX - last[5] * scale;
      const available = pairEndX - turnX;
      const singleScale = Math.min(scale, Math.max(0.05, (available - 80 * scale - 45) / 200));
      const singleGap = Math.max(80 * scale + 48 * singleScale, (available - 152 * singleScale) / 2);
      const singleX = pairEndX - singleGap;
      const singleY = corridor + 7.5 * singleScale;
      const singlePoint = (localX: number, localY: number): string =>
        `${singleX - localY * singleScale} ${singleY + localX * singleScale}`;
      middle += `C${pairExitControl} ${singlePoint(-first[0], -first[1])} ${singlePoint(0, 0)}`;
      const singleStart = measure(`M1201.28 1997.83${middle}`);
      for (const curve of terminalCopy.slice(0, 3)) {
        middle += `C${singlePoint(curve[0], curve[1])} ${singlePoint(curve[2], curve[3])} ${singlePoint(curve[4], curve[5])}`;
      }
      const singleLast = terminalCopy[2];
      // Start the final turn earlier and use a longer horizontal tangent, within
      // the actual room left by the third lobe. The suffix entry stays frozen.
      const singleExitX = singleX - 152 * singleScale;
      const turnRadius = Math.min(180 * scale, (singleExitX - terminalEntryX) * 0.6);
      const roundedTurnX = terminalEntryX + turnRadius;
      const leftWaveX = (singleExitX + roundedTurnX) / 2;
      const leftHandle = Math.min(30 * singleScale, (leftWaveX - roundedTurnX) / 3);
      const turnHandle = Math.min(
        turnRadius * 0.5522847498,
        leftWaveX - roundedTurnX - leftHandle,
      );
      middle += `C${singlePoint(2 * singleLast[4] - singleLast[2], 2 * singleLast[5] - singleLast[3])} ${leftWaveX + leftHandle} ${corridor + wave} ${leftWaveX} ${corridor + wave}`;
      middle += `C${leftWaveX - leftHandle} ${corridor + wave} ${roundedTurnX + turnHandle} ${corridor} ${roundedTurnX} ${corridor}`;
      middle += `C${roundedTurnX - turnHandle} ${corridor} ${terminalX + 89.52} 2258.12 ${terminalEntryX} 2306`;

      // Exact original crossing parameters; split with de Casteljau so only the
      // actual closed lobes, not the long six-cubic tails, receive extra time.
      const partialLength = (index: number, t: number): number => {
        const curve = terminalCopy[index];
        const previous = index === 0 ? [0, 0] : terminalCopy[index - 1].slice(4);
        const mix = (a: number[], b: number[]): number[] =>
          [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
        const a = mix(previous, curve.slice(0, 2));
        const b = mix(curve.slice(0, 2), curve.slice(2, 4));
        const c = mix(curve.slice(2, 4), curve.slice(4));
        const d = mix(a, b);
        const e = mix(b, c);
        const endpoint = mix(d, e);
        const preceding = terminalCopy.slice(0, index).map((segment) => `C${segment.join(' ')}`).join('');
        return measure(`M0 0${preceding}C${a.join(' ')} ${d.join(' ')} ${endpoint.join(' ')}`);
      };
      const firstLoop = [partialLength(0, 0.7841186511348044), partialLength(2, 0.5028695760597145)];
      const loops: ReadonlyArray<readonly [number, number]> = [
        [pairStart + firstLoop[0] * scale, pairStart + firstLoop[1] * scale],
        [secondLoopStart, secondLoopEnd],
        [singleStart + firstLoop[0] * singleScale, singleStart + firstLoop[1] * singleScale],
      ];
      newMiddleLength = measure(`M1201.28 1997.83${middle}`);
      const suffixLength = measure(`M${terminalEntryX} 2306${suffix}`);
      // Measure the immutable reference and replacement in their entirety too;
      // derive the reference middle consistently with the browser's total length.
      oldLength = measure(`${routePrefix}${oldMiddle}${suffix}`);
      newLength = measure(`${routePrefix}${middle}${suffix}`);
      oldMiddleLength = oldLength - prefixLength - suffixLength;
      updateMiddleTiming(baselineLength, loops);
      path.setAttribute('d', `${routePrefix}${middle}${suffix}`);
      render();
    };

    const media = gsap.matchMedia();
    activeCleanups.push(() => media.revert());
    media.add('(min-width: 640px) and (prefers-reduced-motion: no-preference)', () => {
      const previousDashStyles = ['stroke-dasharray', 'stroke-dashoffset'].map(
        (property) => ({
          property,
          value: path.style.getPropertyValue(property),
          priority: path.style.getPropertyPriority(property),
        }),
      );

      draw.pathLength = 0.5;
      updateTerminalRoute();

      render();
      gsap.to(draw, {
        pathLength: 1,
        ease: 'none',
        onUpdate: render,
        scrollTrigger: {
          trigger: route,
          start: 'top 75%',
          endTrigger: end,
          end: 'top bottom',
          scrub: 4,
          invalidateOnRefresh: true,
          onRefresh: updateTerminalRoute,
        },
      });
      return () => {
        // These styles are written manually, outside GSAP's style tracking.
        previousDashStyles.forEach(({ property, value, priority }) => {
          path.style.setProperty(property, value, priority);
        });
      };
    }, region);
  }

  function cleanupHomeScrollStroke(): void {
    activeCleanups.splice(0).forEach((cleanup) => cleanup());
  }

  document.addEventListener('astro:page-load', initHomeScrollStroke);
  document.addEventListener('astro:before-swap', cleanupHomeScrollStroke);
</script>
