---
/**
 * Création page — US-14
 *
 * Composes the Création page:
 *   1. Headerless image hero with centered uppercase page name (full-width)
 *   2. Intro — 3 centered paragraphs (bold segments parsed from i18n)
 *   3. AtelierPresentation — eight supplied photographs in complete rows
 *   4. Facts — 2 ValueBlocks horizontally (stacks on mobile)
 *
 * Footer comes automatically from BaseLayout — not re-added here.
 *
 * All visible text comes from i18n `t()`. Dedicated media copies are used.
 * `--content-max` is respected on every
 * section except the hero. Vertical rhythm uses `--space-section`.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { parseBold } from '../i18n/t';
import Hero from '../components/sections/PageHero.astro';
import AtelierPresentation from '../components/ui/AtelierPresentation.astro';
import { creationMedia, presentationCompositions } from '../data/presentationMedia';
import ValueBlock from '../components/ui/ValueBlock.astro';
import heroImg from '../assets/hero/creation-lead.jpg';
// ValueBlock logos — original supplied SVG pictos.
import iconDev from '../assets/icons/developpement.svg';
import iconCouleurs from '../assets/icons/bobine_fils.svg';

const t = Astro.locals.t;
---

<BaseLayout title={`${t('creation.hero.title')} — ${t('common.brand.name')}`}>
  <!-- 1. Headerless image hero (full-width, breaks content-max) -->
  <Hero image={heroImg} title={t('creation.hero.title')} />

  <!-- 2. Intro — 3 centered paragraphs with bold segments -->
  <section class="content-max section-intro" aria-label={t('common.sectionLabels.intro')}>
    <div class="section-intro__inner" data-reveal-group data-reveal-start="top 80%">
      <p
        class="section-intro__p"
        data-reveal-description
        set:html={parseBold(t('creation.intro.p1'))}
      />
      <p
        class="section-intro__p"
        data-reveal-description
        set:html={parseBold(t('creation.intro.p2'))}
      />
      <p
        class="section-intro__p"
        data-reveal-description
        set:html={parseBold(t('creation.intro.p3'))}
      />
    </div>
  </section>

  <!-- 3. Complete photographic rows; enlargement on mobile only -->
  <section
    class="section-gallery section-gallery--wide"
    aria-label={t('common.sectionLabels.gallery')}
  >
    <AtelierPresentation
      images={creationMedia}
      layout="compact"
      composition={presentationCompositions.creation}
    />
  </section>

  <!-- 4. Facts — 2 ValueBlocks horizontally (stacks on mobile) -->
  <section class="content-max section-facts" aria-label={t('common.sectionLabels.facts')}>
    <h2 class="sr-only">{t('common.sectionLabels.facts')}</h2>
    <div class="section-facts__grid">
      <div>
        <ValueBlock
          logo={iconDev}
          logoVariant="orange"
          title={t('creation.facts.dev.title')}
          description={t('creation.facts.dev.description')}
        />
      </div>
      <div>
        <ValueBlock
          logo={iconCouleurs}
          logoVariant="orange"
          title={t('creation.facts.couleurs.title')}
          description={t('creation.facts.couleurs.description')}
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Shared section rhythm ---- */
  .section-intro,
  .section-gallery,
  .section-facts {
    padding-block: var(--space-section);
  }

  /* The gallery uses the full safe viewport width instead of editorial width. */
  .section-gallery--wide {
    width: 100%;
    padding-inline: var(--content-padding);
    padding-block: clamp(1rem, 2vw, 2rem);
  }

  /* ---- Intro ---- */
  .section-intro__inner {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-intro__p {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-charcoal);
    text-wrap: pretty;
  }

  .section-intro__p :global(strong) {
    font-weight: 600;
    color: var(--color-charcoal);
  }

  /* ---- Facts ---- */
  .section-facts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-component);
  }

  @media (min-width: 768px) {
    .section-facts__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
