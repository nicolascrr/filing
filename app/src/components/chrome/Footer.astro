---
/**
 * Footer — US-07
 *
 * Site-wide footer with contact, journey-from, sitemap and copyright.
 * Background uses `--color-footer` (rgb(50,50,50)) with warm-white text.
 *
 * Structure (top → bottom):
 *   1. Brand logo — centered on mobile, left on desktop.
 *   2. "CONTACT" section — label flanked by embroidery-thread-style lines,
 *      followed by 4 icon links (mail, adresse, instagram, linkedin).
 *   3. "TRAJET DEPUIS" section — same thread-line decoration, followed by
 *      2 icon+label items (gare, aéroport).
 *   4. Sitemap — the 4 pages (Accueil/Création/Production/Galerie).
 *   5. Copyright line at the very bottom (smaller, muted).
 *
 * Accessibility:
 *   - Semantic `<footer>`, `<nav>` for the sitemap, `<address>` for contact.
 *   - Social links open in a new tab with `rel="noopener noreferrer"`.
 *   - All icons have visually-hidden accessible labels (i18n-driven).
 *   - Contact buttons have a distinct high-contrast keyboard focus outline.
 *
 * Responsive (mobile-first):
 *   - V2-09: the three sections (Contact, Trajet depuis, Plan du site)
 *     are ALWAYS stacked vertically (top-to-bottom) on every breakpoint —
 *     not as horizontal columns. Copyright sits at the very bottom with
 *     minimal padding under it.
 *   - Everything is centered for an elegant stacked composition.
 *   - Copyright wraps gracefully to 2 lines at 375px.
 *
 * All visible text comes from `Astro.locals.t` (no hardcoded strings).
 */

import { Image } from 'astro:assets';
import { navItems } from '../../data/nav';

// Footer function pictos only — original supplied SVG assets.
import adresseIcon from '../../assets/icons/localisation.svg';
import aeroportIcon from '../../assets/icons/aeroport.svg';
import gareIcon from '../../assets/icons/gare.svg';
import instagramIcon from '../../assets/icons/instagram.svg';
import linkedinIcon from '../../assets/icons/linkedin.svg';
import mailIcon from '../../assets/icons/mail.svg';
import logo from '../../assets/brand/logo-orange.svg';

interface Props {
  /** Removes the route-to-footer separation after a full-bleed final section. */
  flush?: boolean;
}

const t = Astro.locals.t;
const { flush = false } = Astro.props;
const copyright = t('common.footer.copyright');
const firstSentenceEnd = copyright.indexOf('. ');
const copyrightSplit = firstSentenceEnd === -1 ? copyright.length : firstSentenceEnd + 1;

// Contact link targets (kept here, not in i18n, since they are URLs).
const contact = {
  mail: 'mailto:contact@filing.fr',
  adresse: 'https://maps.app.goo.gl/Lv3RT9JYYH2KcvF9A',
  instagram: 'https://www.instagram.com/filing_broderies/',
  linkedin: 'https://www.linkedin.com/company/filing-broderies/',
};

const journey = {
  gare: 'https://www.google.com/maps/dir/?api=1&origin=Gare%20Lyon%20Part-Dieu%2C%20France&destination=45.903903%2C4.8771092',
  aeroport:
    'https://www.google.com/maps/dir/?api=1&origin=A%C3%A9roport%20Lyon-Saint-Exup%C3%A9ry%2C%20France&destination=45.903903%2C4.8771092',
};
---

<footer class:list={['footer', { 'footer--flush': flush }]}>
  <div class="footer__inner content-max">
    <!-- 1. Logo -->
    <div class="footer__logo">
      <Image
        src={logo}
        alt={t('common.brand.name')}
        width={220}
        height={220 * (logo.height / logo.width)}
        loading="lazy"
      />
    </div>

    <div class="footer__columns">
      <!-- 2. CONTACT -->
      <section class="footer__block" aria-labelledby="footer-contact-label">
        <h2 id="footer-contact-label" class="footer__heading">
          <span class="footer__thread" aria-hidden="true"></span>
          <span class="footer__heading-text">{t('common.footer.contact')}</span>
          <span class="footer__thread" aria-hidden="true"></span>
        </h2>
        <ul class="footer__contact-list">
          <li>
            <a
              class="footer__icon-link footer__icon-link--mail"
              data-footer-email-trigger
              data-hover-slide
              href={contact.mail}
              aria-label={t('common.footer.aria.mail')}
            >
              <span class="footer__icon-frame" data-hover-slide-content aria-hidden="true">
                <img
                  class="footer__icon"
                  src={mailIcon.src}
                  alt=""
                  width={mailIcon.width}
                  height={mailIcon.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </a>
          </li>
          <li>
            <a
              class="footer__icon-link footer__icon-link--adresse"
              data-hover-slide
              href={contact.adresse}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t('common.footer.aria.adresse')}
            >
              <span class="footer__icon-frame" data-hover-slide-content aria-hidden="true">
                <img
                  class="footer__icon"
                  src={adresseIcon.src}
                  alt=""
                  width={adresseIcon.width}
                  height={adresseIcon.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </a>
          </li>
          <li>
            <a
              class="footer__icon-link footer__icon-link--instagram"
              data-hover-slide
              href={contact.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t('common.footer.aria.instagram')}
            >
              <span class="footer__icon-frame" data-hover-slide-content aria-hidden="true">
                <img
                  class="footer__icon"
                  src={instagramIcon.src}
                  alt=""
                  width={instagramIcon.width}
                  height={instagramIcon.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </a>
          </li>
          <li>
            <a
              class="footer__icon-link footer__icon-link--linkedin"
              data-hover-slide
              href={contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t('common.footer.aria.linkedin')}
            >
              <span class="footer__icon-frame" data-hover-slide-content aria-hidden="true">
                <img
                  class="footer__icon"
                  src={linkedinIcon.src}
                  alt=""
                  width={linkedinIcon.width}
                  height={linkedinIcon.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </a>
          </li>
        </ul>
        <div
          id="footer-email-popover"
          class="footer__email-popover"
          hidden
          popover="manual"
          role="dialog"
          aria-label={t('common.footer.email.dialogLabel')}
          data-copy-success={t('common.footer.email.copied')}
          data-copy-manual={t('common.footer.email.manual')}
        >
          <button
            type="button"
            class="footer__email-action"
            data-email-copy
            aria-label={t('common.footer.email.copy')}
            title={t('common.footer.email.copy')}
          >
            <span>contact@filing.fr</span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              focusable="false"
            >
              <g class="footer__email-clipboard">
                <rect x="8" y="4" width="12" height="16" rx="2"></rect>
                <path d="M16 4V2H4v16h4"></path>
              </g>
              <path
                class="footer__email-check"
                d="m5 12 4 4L19 6"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </button>
          <a class="footer__email-action footer__email-send" href={contact.mail}>
            <span>{t('common.footer.email.send')}</span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              focusable="false"><path d="M14 3h7v7M21 3 10 14M10 3H3v18h18v-7"></path></svg
            >
          </a>
          <div data-email-manual hidden>
            <label for="footer-email-address">{t('common.footer.email.address')}</label>
            <input id="footer-email-address" type="text" value="contact@filing.fr" readonly />
          </div>
          <p
            class="footer__email-status sr-only"
            aria-live="polite"
            aria-atomic="true"
            data-email-status
          >
          </p>
        </div>
      </section>

      <!-- 3. TRAJET DEPUIS -->
      <section class="footer__block footer__block--trajet" aria-labelledby="footer-trajet-label">
        <h2 id="footer-trajet-label" class="footer__heading">
          <span class="footer__thread" aria-hidden="true"></span>
          <span class="footer__heading-text">{t('common.footer.trajet')}</span>
          <span class="footer__thread" aria-hidden="true"></span>
        </h2>
        <ul class="footer__trajet-list">
          <li class="footer__trajet-item">
            <a
              class="footer__icon-link footer__icon-link--access"
              data-hover-slide
              href={journey.gare}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t('common.footer.aria.gare')}
              title={t('common.footer.aria.gare')}
            >
              <span class="footer__icon-frame" data-hover-slide-content aria-hidden="true">
                <img
                  class="footer__icon"
                  src={gareIcon.src}
                  alt=""
                  width={gareIcon.width}
                  height={gareIcon.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="footer__trajet-label">{t('common.footer.gare')}</span>
            </a>
          </li>
          <li class="footer__trajet-item">
            <a
              class="footer__icon-link footer__icon-link--access"
              data-hover-slide
              href={journey.aeroport}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t('common.footer.aria.aeroport')}
              title={t('common.footer.aria.aeroport')}
            >
              <span class="footer__icon-frame" data-hover-slide-content aria-hidden="true">
                <img
                  class="footer__icon"
                  src={aeroportIcon.src}
                  alt=""
                  width={aeroportIcon.width}
                  height={aeroportIcon.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="footer__trajet-label">
                {t('common.footer.aeroport')}
              </span>
            </a>
          </li>
        </ul>
      </section>

      <!-- 4. Sitemap -->
      <nav class="footer__block footer__sitemap" aria-label={t('common.footer.sitemapLabel')}>
        <h2 class="footer__heading footer__heading--plain">
          <span class="footer__thread" aria-hidden="true"></span>
          <span class="footer__heading-text">{t('common.footer.sitemapLabel')}</span>
          <span class="footer__thread" aria-hidden="true"></span>
        </h2>
        <ul class="footer__sitemap-list">
          {
            navItems.map((item) => (
              <li>
                <a class="footer__sitemap-link" href={item.href}>
                  {t(item.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- 5. Copyright -->
    <p class="footer__copyright">
      {copyright.slice(0, copyrightSplit)}{' '}
      <a class="footer__legal-link" href="/mentions_legales">{t('common.footer.legalNotice')}</a>
      {copyright.slice(copyrightSplit)}
    </p>
  </div>
</footer>

<script>
  import '../../scripts/footerEmailPopover';
  import '../../scripts/footerLegalNavigation';
</script>

<style>
  .footer__email-popover {
    position: fixed;
    inset: auto;
    margin: 0;
    width: 20rem;
    max-width: calc(100vw - 16px);
    max-height: calc(100dvh - 16px);
    overflow: auto;
    box-sizing: border-box;
    padding: 12px;
    border: 1px solid rgb(248 246 243 / 30%);
    border-radius: 8px;
    background: var(--color-footer);
    color: var(--color-warm-white);
    box-shadow: var(--shadow-lg);
    font-size: var(--text-sm);
    text-align: left;
  }
  .footer__email-popover:not(:popover-open) {
    display: none;
  }
  .footer__email-popover:popover-open {
    /* Opacity leaves placement measurements and the fixed arrow unchanged. */
    animation: footer-email-appear 200ms ease-out;
  }
  @keyframes footer-email-appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .footer__email-popover::before {
    content: '';
    /* Viewport positioning keeps the tip outside the scrolling content. */
    position: fixed;
    left: calc(var(--email-arrow-x) - 5px);
    top: calc(var(--email-arrow-y) - 5px);
    width: 10px;
    height: 10px;
    transform: rotate(45deg);
    background: var(--color-footer);
    border-right: 1px solid rgb(248 246 243 / 30%);
    border-bottom: 1px solid rgb(248 246 243 / 30%);
    pointer-events: none;
  }
  .footer__email-popover[data-placement='below']::before {
    border: 0;
    border-top: 1px solid rgb(248 246 243 / 30%);
    border-left: 1px solid rgb(248 246 243 / 30%);
  }
  .footer__email-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    min-height: 44px;
    padding: 10px;
    border: 1px solid rgb(248 246 243 / 50%);
    border-radius: 4px;
    background: transparent;
    color: inherit;
    text-decoration: none;
    text-align: left;
  }
  .footer__email-action > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .footer__email-action svg {
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
  }
  .footer__email-clipboard,
  .footer__email-check {
    transform-box: view-box;
    transform-origin: center;
    pointer-events: none;
  }
  .footer__email-clipboard {
    opacity: 1;
    transform: scale(1);
  }
  .footer__email-check {
    opacity: 0;
    transform: scale(0.85);
  }
  [data-email-copy][data-copied='true'] .footer__email-clipboard,
  [data-email-copy][data-copied='true'] .footer__email-check {
    transition:
      opacity 180ms ease-out,
      transform 220ms ease-out;
  }
  [data-email-copy][data-copied='true'] .footer__email-clipboard {
    opacity: 0;
    transform: scale(0.85);
  }
  [data-email-copy][data-copied='true'] .footer__email-check {
    opacity: 1;
    transform: scale(1);
  }
  .footer__email-send {
    margin-top: 8px;
    background: #fff;
    color: var(--color-charcoal);
  }
  .footer__email-action:focus-visible,
  .footer__email-popover input:focus-visible {
    outline: 2px solid var(--color-brand-orange);
    outline-offset: 2px;
  }
  .footer__email-popover label {
    display: block;
    margin-top: 12px;
  }
  .footer__email-popover input {
    width: 100%;
    min-height: 44px;
    padding: 8px;
    background: var(--color-footer);
    color: inherit;
    border: 1px solid currentColor;
    user-select: text;
  }
  .footer__email-status:not(.sr-only):not(:empty) {
    margin-top: 12px;
  }
  @media (prefers-reduced-motion: reduce) {
    .footer__email-popover:popover-open {
      animation: none;
    }
    [data-email-copy][data-copied='true'] .footer__email-clipboard,
    [data-email-copy][data-copied='true'] .footer__email-check {
      transition: none;
    }
  }

  .footer {
    background-color: var(--color-footer);
    color: var(--color-warm-white);
    /* V2-09: generous top spacing, minimal bottom padding so the
       copyright sits at the very bottom of the website. */
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: 1rem;
    margin-top: var(--space-section);
  }

  /* V2-10: only the home teaser opts out of the normal route separation. */
  .footer--flush {
    margin-top: 0;
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.25rem, 2vw, 2rem);
    text-align: center;
  }

  /* ---- Logo ---- */
  .footer__logo {
    display: flex;
    justify-content: center;
  }
  .footer__logo :global(img) {
    display: block;
  }

  /* ---- Columns ----
       V2-09: always stacked vertically (column direction on every
       breakpoint). Generous gap between the three sections. */
  .footer__columns {
    --footer-section-gap: clamp(1.25rem, 2.5vw, 2rem);
    --footer-heading-gap: 10px;
    --footer-group-reserve: 17px;
    --footer-transport-gap: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--footer-section-gap);
    width: 100%;
  }

  /* ---- Section heading with thread-line decoration ---- */
  .footer__heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-brand-orange);
    margin-bottom: var(--footer-heading-gap);
    position: relative;
    width: min(100%, 32rem);
  }

  .footer__heading::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    transform: translateY(-50%);
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--color-brand-orange) 70%, transparent) 14%,
      var(--color-brand-orange) 50%,
      color-mix(in srgb, var(--color-brand-orange) 70%, transparent) 86%,
      transparent
    );
    opacity: 0.75;
  }

  .footer__block--trajet > .footer__heading,
  .footer__sitemap > .footer__heading {
    inset-block-start: -6px;
  }

  .footer__heading-text {
    position: relative;
    z-index: 1;
    padding-inline: 1rem;
    background: var(--color-footer);
  }

  /* Continuous centred separator: the line is drawn by the heading pseudo-element. */
  .footer__thread {
    display: none;
  }

  /* ---- Contact icons ---- */
  /* Adapted from Uiverse.io by ubaidi10: four-button card and slide-in icon effect. */
  .footer__contact-list {
    --footer-contact-duration: calc(var(--duration-base) / 2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2vw, 1.25rem);
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    /* Reserve room for the 1.5× zoom and focus ring without clipping. */
    padding: var(--footer-group-reserve) clamp(1.25rem, 3vw, 1.5625rem);
    background-color: transparent;
    box-shadow: var(--shadow-md);
  }

  .footer__contact-list > li {
    flex: 0 0 52px;
  }

  .footer__icon-link {
    --footer-contact-hover-bg: var(--color-brand-orange);
    --hover-slide-bg: var(--color-footer);
    --hover-slide-hover-bg: var(--footer-contact-hover-bg);
    --hover-slide-duration: var(--footer-contact-duration);
    --hover-slide-scale: 1.5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
  }

  .footer__icon-link--instagram {
    --footer-contact-hover-bg: #d62976;
  }

  .footer__icon-link--linkedin {
    --footer-contact-hover-bg: #0072b1;
  }

  .footer__icon-link .footer__icon-frame {
    width: 20px;
    height: 20px;
  }

  .footer__icon-link .footer__icon {
    /* Local tint only; original SVG assets remain untouched. */
    filter: brightness(0) invert(1);
  }

  .footer__icon-link:focus-visible {
    outline: 2px solid var(--color-warm-white);
    outline-offset: 2px;
  }

  .footer__icon-link--mail:is(:hover, :focus-visible) .footer__icon,
  .footer__icon-link--adresse:is(:hover, :focus-visible) .footer__icon,
  .footer__icon-link--access:is(:hover, :focus-visible) .footer__icon {
    filter: brightness(0);
  }

  .footer__icon-frame {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
  }

  .footer__icon {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 31px;
    max-height: 31px;
    object-fit: contain;
    object-position: center;
  }

  /* ---- Trajet items ---- */
  .footer__block--trajet {
    width: min(100%, 32rem);
    min-width: 0;
  }

  .footer__trajet-list {
    --footer-contact-duration: 0.3s;
    display: flex;
    flex-direction: column;
    gap: var(--footer-transport-gap);
    align-items: center;
    width: 100%;
    padding-block: var(--footer-group-reserve);
  }
  .footer__trajet-item {
    width: 100%;
    min-width: 0;
    display: flex;
    justify-content: center;
    /* Reserve only the 1.03× zoom and focus ring. */
    padding: 0 calc(1.5% + 4px);
  }
  .footer__icon-link--access {
    --hover-slide-scale: 1.03;
    flex: 0 0 auto;
    justify-content: flex-start;
    gap: clamp(6px, 1.5vw, 12px);
    width: max-content;
    height: auto;
    min-height: 52px;
    padding: 12px clamp(8px, 2vw, 16px);
    color: var(--color-warm-white);
    transform-origin: center;
  }
  .footer__icon-link--access:is(:hover, :focus-visible) {
    color: #1a1a1a;
  }
  .footer__trajet-label {
    flex-shrink: 0;
    font-size: clamp(0.75rem, 3vw, var(--text-sm));
    color: inherit;
    text-align: left;
    white-space: nowrap;
  }

  /* ---- Sitemap ---- */
  .footer__sitemap-list {
    padding-block: var(--footer-group-reserve);
    display: flex;
    flex-direction: column;
    gap: 0;
    align-items: center;
  }
  .footer__sitemap-link {
    display: inline-block;
    min-height: 44px;
    padding: 0.5rem 0.25rem;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(248, 246, 243, 0.85);
    transition: color var(--duration-base) var(--ease-luxury);
  }
  .footer__sitemap-link:hover,
  .footer__sitemap-link:focus-visible {
    color: var(--color-brand-orange);
  }

  /* ---- Copyright ---- */
  .footer__legal-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.25rem;
    color: var(--color-warm-white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer__legal-link:focus-visible {
    outline-color: var(--color-warm-white);
  }

  .footer__copyright {
    margin-top: 0.5rem;
    font-size: var(--text-xs);
    color: rgba(248, 246, 243, 0.6);
    text-align: center;
    max-width: 32rem;
    line-height: 1.5;
  }

  /* ---- Desktop layout (md+) ----
     V2-09: sections stay stacked vertically (not horizontal columns).
     Only minor refinements: constrain the stacked content width and
     keep everything centered for an elegant composition. */
  @media (min-width: 768px) {
    .footer__columns {
      max-width: 36rem;
    }
    .footer__copyright {
      max-width: 40rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__sitemap-link {
      transition: none;
    }
  }
</style>
