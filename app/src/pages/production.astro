---
/**
 * Production page — US-16
 *
 * Composes the Production page using BaseLayout. All visible text comes
 * from i18n `t()`; presentation photographs use dedicated supplied copies.
 *
 * Section order:
 *   1. Page hero (image, headerless) — full-width, breaks `--content-max`.
 *   2. Intro — 2 centered paragraphs (bold segments parsed).
 *   3. AtelierPresentation — six production photographs.
 *   4. Facts — 4 ValueBlocks in a 2×2 grid (stacked on mobile).
 *   5. AtelierPresentation — six finishing photographs, compact layout.
 *   6. Finishing — 2 centered paragraphs (bold segments parsed).
 *
 * Footer is rendered by BaseLayout — not re-added here.
 *
 * `--content-max` is respected on every section EXCEPT the full-width hero.
 * Vertical rhythm uses `--space-section`.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { parseBold } from '../i18n/t';
import Hero from '../components/sections/PageHero.astro';
import AtelierPresentation from '../components/ui/AtelierPresentation.astro';
import { productionMedia, finishingMedia, presentationCompositions } from '../data/presentationMedia';
import ValueBlock from '../components/ui/ValueBlock.astro';

import pageHeroProduction from '../assets/hero/production-lead.jpg';
// ValueBlock logos — original supplied SVG pictos.
import iconSurface from '../assets/icons/superficie.svg';
import iconPreparation from '../assets/icons/finition.svg';
import iconTetes from '../assets/icons/tete_machine.svg';
import iconDecoupe from '../assets/icons/decoupe.svg';

const t = Astro.locals.t;
---

<BaseLayout title={`${t('production.hero.title')} — ${t('common.brand.name')}`}>
  <!-- 1. Page hero (image, headerless) — full-width, breaks content-max -->
  <Hero image={pageHeroProduction} title={t('production.hero.title')} />

  <!-- 2. Intro — 2 centered paragraphs with bold segments -->
  <section class="content-max section-intro" aria-label={t('common.sectionLabels.intro')}>
    <div class="section-intro__inner" data-reveal-group data-reveal-start="top 80%">
      <p
        class="section-intro__p"
        data-reveal-description
        set:html={parseBold(t('production.intro.p1'))}
      />
      <p
        class="section-intro__p"
        data-reveal-description
        set:html={parseBold(t('production.intro.p2'))}
      />
    </div>
  </section>

  <!-- 3. Production rows; enlargement on mobile only -->
  <section
    class="section-gallery section-gallery--wide"
    aria-label={t('common.sectionLabels.gallery')}
  >
    <AtelierPresentation
      images={productionMedia}
      layout="compact"
      composition={presentationCompositions.production}
    />
  </section>

  <!-- 4. Facts — 4 ValueBlocks in a 2×2 grid (stacked on mobile) -->
  <section class="content-max section-facts" aria-label={t('common.sectionLabels.facts')}>
    <h2 class="sr-only">{t('common.sectionLabels.facts')}</h2>
    <div class="section-facts__grid">
      <div>
        <ValueBlock
          logo={iconSurface}
          logoVariant="orange"
          logoScale={1.3}
          title={t('production.facts.surface.title')}
          description={t('production.facts.surface.description')}
        />
      </div>
      <div>
        <ValueBlock
          logo={iconPreparation}
          logoVariant="orange"
          title={t('production.facts.preparation.title')}
          description={t('production.facts.preparation.description')}
        />
      </div>
      <div>
        <ValueBlock
          logo={iconTetes}
          logoVariant="orange"
          logoScale={1.2}
          class="production-machine"
          title={t('production.facts.tetes.title')}
          description={t('production.facts.tetes.description')}
        />
      </div>
      <div>
        <ValueBlock
          logo={iconDecoupe}
          logoVariant="orange"
          title={t('production.facts.decoupe.title')}
          description={t('production.facts.decoupe.description')}
        />
      </div>
    </div>
  </section>

  <!-- 5. Finishing rows; enlargement on mobile only -->
  <section
    class="section-gallery section-gallery--wide"
    aria-label={t('common.sectionLabels.carousel')}
  >
    <AtelierPresentation
      images={finishingMedia}
      layout="compact"
      composition={presentationCompositions.finishing}
    />
  </section>

  <!-- 6. Finishing — 2 centered paragraphs with bold segments -->
  <section class="content-max section-finishing" aria-label={t('common.sectionLabels.finishing')}>
    <div class="section-finishing__inner" data-reveal-group data-reveal-start="top 80%">
      <p
        class="section-finishing__p"
        data-reveal-description
        set:html={parseBold(t('production.finishing.p1'))}
      />
      <p
        class="section-finishing__p"
        data-reveal-description
        set:html={parseBold(t('production.finishing.p2'))}
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Shared section rhythm ---- */
  .section-intro,
  .section-gallery,
  .section-facts,
  .section-finishing {
    padding-block: var(--space-section);
  }

  /* Galleries deliberately extend beyond the standard editorial measure. */
  .section-gallery--wide {
    width: 100%;
    padding-inline: var(--content-padding);
  }

  .section-gallery--wide {
    padding-block: clamp(1rem, 2vw, 2rem);
  }

  .section-facts :global(.production-machine .value-block__logo) {
    height: calc((var(--value-icon-size) - 1.3rem) * 0.9);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  /* ---- Intro ---- */
  .section-intro__inner {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-intro__p {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-charcoal);
    text-wrap: pretty;
  }

  .section-intro__p :global(strong) {
    font-weight: 600;
    color: var(--color-charcoal);
  }

  /* ---- Facts (2×2 grid, stacked on mobile) ---- */
  .section-facts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-component);
  }

  @media (min-width: 768px) {
    .section-facts__grid {
      grid-template-columns: repeat(2, 1fr);
      align-items: start;
    }
  }

  /* ---- Finishing ---- */
  .section-finishing__inner {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-finishing__p {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-charcoal);
    text-wrap: pretty;
    white-space: pre-line; /* preserve the `\n` in finishing.p2 */
  }

  .section-finishing__p :global(strong) {
    font-weight: 600;
    color: var(--color-charcoal);
  }
</style>
