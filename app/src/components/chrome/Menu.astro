---
import { navItems } from '../../data/nav';
import LanguageSwitcher from './LanguageSwitcher.astro';

const t = Astro.locals.t;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<div class="nav-block" data-thread-menu>
  <button
    type="button"
    class="icon-frame"
    id="iconFrame"
    data-menu-trigger
    aria-expanded="false"
    aria-controls="threadStage"
    aria-label={t('common.menu.triggerLabel')}
    data-label-open={t('common.menu.triggerLabel')}
    data-label-close={t('common.menu.closeLabel')}
  >
    <svg
      class="spool-icon"
      id="spoolIcon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 56 56"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <ellipse cx="28" cy="10" rx="16" ry="5"></ellipse>
      <ellipse cx="28" cy="46" rx="16" ry="5"></ellipse>
      <path d="M12 10 L12 46"></path>
      <path d="M44 10 L44 46"></path>
      <path d="M15 20 L41 30"></path>
      <path d="M15 30 L41 20"></path>
      <path d="M44 39 C52 43,54 49,48 53" stroke-width="1.8"></path>
      <circle cx="48.5" cy="53.5" r="1.8" fill="currentColor" stroke="none"></circle>
    </svg>
  </button>
  <div
    class="thread-stage"
    id="threadStage"
    data-thread-stage
    role="dialog"
    aria-modal="true"
    aria-label={t('common.menu.dialogLabel')}
    aria-hidden="true"
    inert
  >
    <svg class="menu__filets" aria-hidden="true" focusable="false">
      <path data-menu-thread pathLength="1"></path>
    </svg>
    <div class="menu__panel">
      <nav aria-label={t('common.menu.dialogLabel')}>
        <ol class="menu__grid">
          {
            navItems.map((item) => (
              <li data-route={item.href}>
                <a
                  href={item.href}
                  class="menu__link"
                  data-menu-link
                  aria-current={
                    (item.href.replace(/\/+$/, '') || '/') === currentPath ? 'page' : undefined
                  }
                >
                  <span class="menu__title">
                    <span class="menu__label">{t(item.labelKey)}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <LanguageSwitcher class="menu__languages" />
    </div>
  </div>
</div>

<style>
  .nav-block {
    --menu-thread-color: var(--color-brand-orange);
    --menu-radius: 12px;
    --menu-thread-width: 1.5px;
    --menu-thread-gap: 28px;
    --menu-hover-duration: 0.3s;
    position: fixed;
    top: var(--content-padding);
    right: var(--content-padding);
    z-index: 92;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    width: min(480px, calc(100vw - 2 * var(--content-padding)));
    color: var(--menu-thread-color);
    pointer-events: none;
  }
  .nav-block[data-on-dark='true'] {
    --menu-thread-color: var(--color-warm-white);
  }
  .nav-block[data-lightbox-blocked='true'] {
    visibility: hidden;
    pointer-events: none;
  }
  .icon-frame {
    position: relative;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    pointer-events: auto;
  }
  .spool-icon {
    width: 100%;
    height: 100%;
    transform-origin: center;
  }
  .thread-stage {
    position: relative;
    width: 100%;
    padding-top: var(--menu-thread-gap);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .thread-stage[aria-hidden='false'] {
    pointer-events: auto;
  }
  .menu__panel {
    position: relative;
    padding: 16px;
    max-height: calc(100dvh - 44px - 2 * var(--content-padding) - var(--menu-thread-gap));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-charcoal);
    color: var(--color-warm-white);
    border-radius: var(--menu-radius);
    box-shadow: var(--shadow-lg);
  }
  .menu__filets {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .menu__filets path {
    fill: none;
    stroke: var(--menu-thread-color);
    stroke-width: var(--menu-thread-width);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  /* Stitch only the straight runs; keep the connector and rounded joins intact.
     The path's dash properties remain exclusively owned by GSAP's reveal. */
  @supports (mask-image: linear-gradient(#000, #000)) {
    .menu__filets {
      mask-image:
        linear-gradient(#000, #000), linear-gradient(#000, #000), linear-gradient(#000, #000),
        linear-gradient(#000, #000), linear-gradient(#000, #000),
        repeating-linear-gradient(to right, #000 0 5px, transparent 5px 9px),
        repeating-linear-gradient(to bottom, #000 0 5px, transparent 5px 9px);
      mask-size:
        100% var(--menu-thread-gap),
        var(--menu-radius) var(--menu-radius),
        var(--menu-radius) var(--menu-radius),
        var(--menu-radius) var(--menu-radius),
        var(--menu-radius) var(--menu-radius),
        calc(100% - 2 * var(--menu-radius)) 100%,
        100% calc(100% - var(--menu-thread-gap) - 2 * var(--menu-radius));
      mask-position:
        top,
        bottom left,
        bottom right,
        left 0 top var(--menu-thread-gap),
        right 0 top var(--menu-thread-gap),
        center,
        left 0 bottom var(--menu-radius);
      mask-repeat: no-repeat;
    }
  }
  .menu__grid {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    border-radius: var(--menu-radius);
  }
  .menu__grid li {
    min-width: 0;
    border-bottom: none;
    transition: background-color var(--menu-hover-duration) var(--ease-luxury);
  }
  .menu__grid li:is([data-route='/'], [data-route='/creation']) {
    border-bottom: 1px solid rgb(248 246 243 / 18%);
  }
  .menu__grid li:hover,
  .menu__grid li:has(> a[aria-current='page']) {
    background-color: var(--color-brand-orange);
  }
  .menu__link {
    position: relative;
    display: flex;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    align-items: center;
    gap: 1.25rem;
    min-height: 78px;
    padding: 17px calc(1.5% + 16px);
    overflow: hidden;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    text-decoration: none;
    transition: color var(--menu-hover-duration) var(--ease-luxury);
  }
  .menu__grid li:hover .menu__link,
  .menu__grid li:has(> a[aria-current='page']) .menu__link {
    color: #000;
  }
  .menu__title {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .menu__label {
    display: inline-block;
    transform-origin: left center;
    transition: transform var(--menu-hover-duration) var(--ease-luxury);
  }
  .menu__grid
    li:not(:has(> .menu__link[aria-current='page'])):is(:hover, :has(> .menu__link:focus-visible))
    .menu__label {
    transform: scale(1.03);
  }
  /* Same upward slide as the footer's Uiverse contact icons. */
  .menu__grid
    li:not(:has(> .menu__link[aria-current='page'])):is(:hover, :has(> .menu__link:focus-visible))
    .menu__title {
    animation: menu-title-slide-in var(--menu-hover-duration) var(--ease-luxury) both;
  }
  .menu__link:focus-visible {
    outline: 2px solid var(--color-warm-white);
    outline-offset: -4px;
  }
  .menu__grid li .menu__link:not([aria-current='page']):active .menu__label {
    transform: scale(0.98);
  }
  .menu__link[aria-current='page'] .menu__label {
    transform: none;
    transition: none;
  }
  @keyframes menu-title-slide-in {
    from {
      transform: translateY(50px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  :global(.menu__languages) {
    margin-top: 12px;
  }
  :global(.menu__languages .lang-switcher__list) {
    justify-content: center;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .menu__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .menu__link {
      min-height: 114px;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .menu__grid li:nth-child(odd) {
      border-right: 1px solid rgb(248 246 243 / 18%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu__grid li,
    .menu__link,
    .menu__label {
      transition: none;
    }
    .menu__grid li:is(:hover, :has(> .menu__link:focus-visible)) .menu__label,
    .menu__grid li .menu__link:active .menu__label {
      transform: none;
    }
    .menu__grid li:is(:hover, :has(> .menu__link:focus-visible)) .menu__title {
      animation: none;
    }
  }
</style>

<script>
  import { gsap } from '../../scripts/gsap';

  type MenuState = 'closed' | 'opening' | 'open' | 'closing';
  const cleanups: Array<() => void> = [];

  function initMenu(root: HTMLElement): () => void {
    const trigger = root.querySelector<HTMLButtonElement>('[data-menu-trigger]');
    const spool = root.querySelector<SVGElement>('.spool-icon');
    const stage = root.querySelector<HTMLElement>('[data-thread-stage]');
    const panel = root.querySelector<HTMLElement>('.menu__panel');
    const threadSvg = root.querySelector<SVGSVGElement>('.menu__filets');
    const thread = root.querySelector<SVGPathElement>('[data-menu-thread]');
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-menu-link]'));
    const syncCurrentPage = (): void => {
      const normalizePath = (url: URL): string => url.pathname.replace(/\/+$/, '') || '/';
      const currentPath = normalizePath(new URL(window.location.href));
      let matched = false;
      links.forEach((link) => {
        const active = !matched && normalizePath(new URL(link.href)) === currentPath;
        if (active) {
          link.setAttribute('aria-current', 'page');
          matched = true;
        } else link.removeAttribute('aria-current');
      });
    };
    syncCurrentPage();
    const tiles = Array.from(root.querySelectorAll<HTMLElement>('.menu__grid > li'));
    if (!trigger || !spool || !stage || !panel || !threadSvg || !thread) return () => undefined;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const context = gsap.context(() => undefined, root);
    let state: MenuState = 'closed';
    let generation = 0;
    let disposed = false;
    let animation: gsap.core.Timeline | null = null;
    let rotation: gsap.core.Tween | null = null;
    let restoringLanguageFocus = false;
    const updateGeometry = (): void => {
      if (disposed) return;
      const styles = getComputedStyle(root);
      const { width, height } = panel.getBoundingClientRect();
      if (!width || !height) return;
      const gap = parseFloat(styles.getPropertyValue('--menu-thread-gap'));
      const inset = parseFloat(styles.getPropertyValue('--menu-thread-width')) / 2;
      const radius = Math.min(
        parseFloat(styles.getPropertyValue('--menu-radius')),
        width / 2,
        height / 2,
      );
      const arc = radius - inset;
      const right = width - inset;
      const bottom = gap + height - inset;
      const top = gap + inset;
      const cx = width - radius;
      const cy = gap + radius;
      const joinX = cx + arc / Math.SQRT2;
      const joinY = cy - arc / Math.SQRT2;
      // Stop one stroke width before the junction: the round cap touches it
      // without painting the connector/outline junction a second time.
      const endAngle = -Math.PI / 4 + 2 * Math.asin(inset / arc);
      const endX = cx + arc * Math.cos(endAngle);
      const endY = cy + arc * Math.sin(endAngle);
      // Pixel-sized coordinates keep the CSS radius intact at every aspect ratio.
      threadSvg.setAttribute('viewBox', `0 0 ${width} ${gap + height}`);
      thread.setAttribute(
        'd',
        `M${width - 20} 0V12Q${width - 20} ${gap} ${joinX} ${joinY}` +
          `A${arc} ${arc} 0 0 0 ${cx} ${top}` +
          `H${radius}A${arc} ${arc} 0 0 0 ${inset} ${gap + radius}` +
          `V${gap + height - radius}A${arc} ${arc} 0 0 0 ${radius} ${bottom}` +
          `H${cx}A${arc} ${arc} 0 0 0 ${right} ${gap + height - radius}` +
          `V${cy}A${arc} ${arc} 0 0 0 ${endX} ${endY}`,
      );
    };
    const geometryObserver = new ResizeObserver(updateGeometry);
    geometryObserver.observe(panel);
    const heroes = Array.from(document.querySelectorAll<HTMLElement>('.hero, .page-hero'));
    const setState = (next: MenuState): void => {
      state = next;
      root.dataset.menuState = next;
    };
    const rotate = (degrees: number, duration: number): void => {
      rotation?.kill();
      context.add(() => {
        if (reduced.matches) {
          gsap.set(spool, { rotation: degrees });
          return;
        }
        // gsap.to starts from the rendered hover rotation, never from zero.
        rotation = gsap.to(spool, {
          rotation: degrees,
          duration: reduced.matches ? 0 : duration,
          ease: 'power3.out',
          overwrite: 'auto',
        });
      });
    };
    const setA11y = (open: boolean): void => {
      trigger.setAttribute('aria-expanded', String(open));
      trigger.setAttribute(
        'aria-label',
        (open ? trigger.dataset.labelClose : trigger.dataset.labelOpen) ?? '',
      );
      stage.setAttribute('aria-hidden', String(!open));
      stage.inert = !open;
    };
    const close = (restoreFocus = false, immediate = false): void => {
      contrast();
      if (state === 'closed') return;
      const run = ++generation;
      animation?.kill();
      setState('closing');
      setA11y(false);
      rotate(0, 0.32);
      if (immediate || reduced.matches) {
        context.add(() => {
          gsap.set(stage, { opacity: 0 });
          gsap.set(thread, { strokeDashoffset: 1 });
        });
        stage.style.visibility = 'hidden';
        setState('closed');
        if (restoreFocus) trigger.focus({ preventScroll: true });
        return;
      }
      context.add(() => {
        animation = gsap
          .timeline({
            onComplete: () => {
              if (disposed || run !== generation) return;
              stage.style.visibility = 'hidden';
              setState('closed');
            },
          })
          .to(thread, { strokeDashoffset: 1, duration: 0.32, ease: 'power2.in' }, 0)
          .to(
            stage,
            {
              opacity: 0,
              duration: immediate || reduced.matches ? 0 : 0.32,
              ease: 'power2.in',
            },
            0,
          );
      });
      if (restoreFocus) trigger.focus({ preventScroll: true });
    };
    const open = (): void => {
      syncCurrentPage();
      contrast();
      const run = ++generation;
      animation?.kill();
      updateGeometry();
      setState('opening');
      setA11y(true);
      stage.style.visibility = 'visible';
      rotate(90, 0.45);
      if (reduced.matches) {
        context.add(() => {
          gsap.set(stage, { opacity: 1 });
          gsap.set(thread, { strokeDashoffset: 0 });
          gsap.set(tiles, { y: 0 });
        });
        setState('open');
        links[0]?.focus({ preventScroll: true });
        return;
      }
      context.add(() => {
        animation = gsap
          .timeline({
            onComplete: () => {
              if (disposed || run !== generation) return;
              setState('open');
            },
          })
          .to(stage, { opacity: 1, duration: reduced.matches ? 0 : 0.28, ease: 'power3.out' }, 0)
          .to(thread, { strokeDashoffset: 0, duration: 0.8, ease: 'power2.out' }, 0)
          .fromTo(
            tiles,
            { y: 20 },
            {
              y: 0,
              duration: reduced.matches ? 0 : 0.8,
              stagger: reduced.matches ? 0 : 0.07,
              ease: 'power3.out',
            },
            0,
          );
      });
      // Links and flags are operable immediately, not after the decoration.
      links[0]?.focus({ preventScroll: true });
    };
    const onClick = (): void => {
      if (state === 'closed' || state === 'closing') open();
      else close();
    };
    const onEnter = (): void => {
      if (state === 'closed' && !restoringLanguageFocus) rotate(90, 0.6);
    };
    const onLanguageFocus = (): void => {
      // Focus events are synchronous: suppress only this restoration, not the
      // next deliberate keyboard focus or pointer hover.
      restoringLanguageFocus = true;
      try {
        trigger.focus({ preventScroll: true });
      } finally {
        restoringLanguageFocus = false;
      }
    };
    const onLeave = (): void => {
      if (state === 'closed') rotate(0, 0.45);
    };
    const onOutside = (event: MouseEvent): void => {
      if (!root.contains(event.target as Node)) close();
    };
    const onKey = (event: KeyboardEvent): void => {
      if (state !== 'opening' && state !== 'open') return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close(true);
        return;
      }
      if (event.key !== 'Tab') return;
      const focusable = [
        trigger,
        ...Array.from(stage.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')),
      ];
      const first = focusable[0];
      const last = focusable.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      } else if (!root.contains(document.activeElement)) {
        event.preventDefault();
        first?.focus();
      }
    };
    const onLink = (): void => close(false, true);
    const contrast = (): void => {
      if (disposed) return;
      const bounds = trigger.getBoundingClientRect();
      const x = bounds.left + bounds.width / 2;
      const y = bounds.top + bounds.height / 2;
      // Compare the spool's actual center with hero geometry, not hit testing:
      // the open panel and other overlays must not change the backdrop color.
      root.dataset.onDark = String(
        heroes.some((hero) => {
          const heroBounds = hero.getBoundingClientRect();
          return (
            x >= heroBounds.left &&
            x < heroBounds.right &&
            y >= heroBounds.top &&
            y < heroBounds.bottom
          );
        }),
      );
    };
    const contrastObserver = new ResizeObserver(contrast);
    heroes.forEach((hero) => contrastObserver.observe(hero));
    contrastObserver.observe(trigger);
    const blockLightbox = (blocked: boolean): void => {
      root.dataset.lightboxBlocked = String(blocked);
      trigger.disabled = blocked;
      if (blocked) close(false, true);
    };
    const onLightbox = (event: Event): void =>
      blockLightbox(Boolean((event as CustomEvent<{ open: boolean }>).detail?.open));
    const lightboxObserver = new MutationObserver(() =>
      blockLightbox(document.documentElement.dataset.lightboxOpen === 'true'),
    );
    lightboxObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-lightbox-open'],
    });
    const onMotionChange = (): void => {
      animation?.progress(1);
      rotation?.progress(1);
    };
    setState('closed');
    setA11y(false);
    updateGeometry();
    context.add(() => gsap.set(thread, { strokeDasharray: 1, strokeDashoffset: 1 }));
    contrast();
    blockLightbox(document.documentElement.dataset.lightboxOpen === 'true');
    trigger.addEventListener('click', onClick);
    trigger.addEventListener('mouseenter', onEnter);
    trigger.addEventListener('mouseleave', onLeave);
    trigger.addEventListener('focus', onEnter);
    trigger.addEventListener('site:menu-language-focus', onLanguageFocus);
    trigger.addEventListener('blur', onLeave);
    document.addEventListener('click', onOutside);
    document.addEventListener('keydown', onKey);
    document.addEventListener('site:lightbox-state', onLightbox);
    window.addEventListener('scroll', contrast, { passive: true });
    window.addEventListener('resize', contrast);
    window.addEventListener('popstate', syncCurrentPage);
    reduced.addEventListener('change', onMotionChange);
    links.forEach((link) => link.addEventListener('click', onLink));
    return () => {
      disposed = true;
      generation++;
      animation?.kill();
      rotation?.kill();
      context.revert();
      lightboxObserver.disconnect();
      contrastObserver.disconnect();
      geometryObserver.disconnect();
      trigger.removeEventListener('click', onClick);
      trigger.removeEventListener('mouseenter', onEnter);
      trigger.removeEventListener('mouseleave', onLeave);
      trigger.removeEventListener('focus', onEnter);
      trigger.removeEventListener('site:menu-language-focus', onLanguageFocus);
      trigger.removeEventListener('blur', onLeave);
      document.removeEventListener('click', onOutside);
      document.removeEventListener('keydown', onKey);
      document.removeEventListener('site:lightbox-state', onLightbox);
      window.removeEventListener('scroll', contrast);
      window.removeEventListener('resize', contrast);
      window.removeEventListener('popstate', syncCurrentPage);
      reduced.removeEventListener('change', onMotionChange);
      links.forEach((link) => link.removeEventListener('click', onLink));
    };
  }
  document.addEventListener('astro:page-load', () => {
    cleanups.splice(0).forEach((cleanup) => cleanup());
    document
      .querySelectorAll<HTMLElement>('[data-thread-menu]')
      .forEach((root) => cleanups.push(initMenu(root)));
  });
  document.addEventListener('astro:before-swap', () =>
    cleanups.splice(0).forEach((cleanup) => cleanup()),
  );
</script>
