---
/**
 * Footer — US-07
 *
 * Site-wide footer with contact, journey-from, sitemap and copyright.
 * Background uses `--color-footer` (rgb(50,50,50)) with warm-white text.
 *
 * Structure (top → bottom):
 *   1. Logo (placeholder) — centered on mobile, left on desktop.
 *   2. "CONTACT" section — label flanked by embroidery-thread-style lines,
 *      followed by 4 icon links (mail, adresse, instagram, linkedin).
 *   3. "TRAJET DEPUIS" section — same thread-line decoration, followed by
 *      2 icon+label items (gare, aéroport).
 *   4. Sitemap — the 4 pages (Accueil/Création/Production/Galerie).
 *   5. Copyright line at the very bottom (smaller, muted).
 *
 * Accessibility:
 *   - Semantic `<footer>`, `<nav>` for the sitemap, `<address>` for contact.
 *   - Social links open in a new tab with `rel="noopener noreferrer"`.
 *   - All icons have visually-hidden accessible labels (i18n-driven).
 *   - Focus-visible styles inherited globally (gold outline).
 *
 * Responsive (mobile-first):
 *   - V2-09: the three sections (Contact, Trajet depuis, Plan du site)
 *     are ALWAYS stacked vertically (top-to-bottom) on every breakpoint —
 *     not as horizontal columns. Copyright sits at the very bottom with
 *     minimal padding under it.
 *   - Everything is centered for an elegant stacked composition.
 *   - Copyright wraps gracefully to 2 lines at 375px.
 *
 * All visible text comes from `Astro.locals.t` (no hardcoded strings).
 */

import { Image } from 'astro:assets';
import { navItems } from '../../data/nav';

// Footer function pictos only — real matching assets from src/content/Pictos/.
import adresseIcon from '../../content/Pictos/adresse.png';
import aeroportIcon from '../../content/Pictos/aeroport.png';
import gareIcon from '../../content/Pictos/gare.png';
import instagramIcon from '../../content/Pictos/instagram.png';
import linkedinIcon from '../../content/Pictos/linkedin.png';
import mailIcon from '../../content/Pictos/mail.png';
import logo from '../../assets/placeholders/logo.svg';

interface Props {
  /** Removes the route-to-footer separation after a full-bleed final section. */
  flush?: boolean;
}

const t = Astro.locals.t;
const { flush = false } = Astro.props;

// Contact link targets (kept here, not in i18n, since they are URLs).
const contact = {
  mail: 'mailto:contact@filing-broderies.fr',
  adresse: 'https://maps.google.com/?q=Lyon+France',
  instagram: 'https://www.instagram.com/',
  linkedin: 'https://www.linkedin.com/',
};
---

<footer class:list={['footer', { 'footer--flush': flush }]}>
  <div class="footer__inner content-max">
    <!-- 1. Logo -->
    <div class="footer__logo">
      <Image src={logo} alt={t('common.brand.name')} width={220} height={44} loading="lazy" />
    </div>

    <div class="footer__columns">
      <!-- 2. CONTACT -->
      <section class="footer__block" aria-labelledby="footer-contact-label">
        <h2 id="footer-contact-label" class="footer__heading">
          <span class="footer__thread" aria-hidden="true"></span>
          <span class="footer__heading-text">{t('common.footer.contact')}</span>
          <span class="footer__thread" aria-hidden="true"></span>
        </h2>
        <ul class="footer__contact-list">
          <li>
            <a
              class="footer__icon-link"
              href={contact.mail}
              aria-label={t('common.footer.aria.mail')}
            >
              <span class="footer__icon-frame" aria-hidden="true">
                <img
                  class="footer__icon"
                  src={mailIcon.src}
                  alt=""
                  width={mailIcon.width}
                  height={mailIcon.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </a>
          </li>
          <li>
            <a
              class="footer__icon-link"
              href={contact.adresse}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t('common.footer.aria.adresse')}
            >
              <span class="footer__icon-frame" aria-hidden="true">
                <img
                  class="footer__icon"
                  src={adresseIcon.src}
                  alt=""
                  width={adresseIcon.width}
                  height={adresseIcon.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </a>
          </li>
          <li>
            <a
              class="footer__icon-link"
              href={contact.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t('common.footer.aria.instagram')}
            >
              <span class="footer__icon-frame" aria-hidden="true">
                <img
                  class="footer__icon"
                  src={instagramIcon.src}
                  alt=""
                  width={instagramIcon.width}
                  height={instagramIcon.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </a>
          </li>
          <li>
            <a
              class="footer__icon-link"
              href={contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t('common.footer.aria.linkedin')}
            >
              <span class="footer__icon-frame" aria-hidden="true">
                <img
                  class="footer__icon"
                  src={linkedinIcon.src}
                  alt=""
                  width={linkedinIcon.width}
                  height={linkedinIcon.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </a>
          </li>
        </ul>
      </section>

      <!-- 3. TRAJET DEPUIS -->
      <section class="footer__block" aria-labelledby="footer-trajet-label">
        <h2 id="footer-trajet-label" class="footer__heading">
          <span class="footer__thread" aria-hidden="true"></span>
          <span class="footer__heading-text">{t('common.footer.trajet')}</span>
          <span class="footer__thread" aria-hidden="true"></span>
        </h2>
        <ul class="footer__trajet-list">
          <li class="footer__trajet-item">
            <span class="footer__trajet-icon footer__icon-frame">
              <img
                class="footer__icon"
                src={gareIcon.src}
                alt={t('common.footer.aria.gare')}
                width={gareIcon.width}
                height={gareIcon.height}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="footer__trajet-label">{t('common.footer.gare')}</span>
          </li>
          <li class="footer__trajet-item">
            <span class="footer__trajet-icon footer__icon-frame">
              <img
                class="footer__icon"
                src={aeroportIcon.src}
                alt={t('common.footer.aria.aeroport')}
                width={aeroportIcon.width}
                height={aeroportIcon.height}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="footer__trajet-label">
              {t('common.footer.aeroport')}
            </span>
          </li>
        </ul>
      </section>

      <!-- 4. Sitemap -->
      <nav class="footer__block footer__sitemap" aria-label={t('common.footer.sitemapLabel')}>
        <h2 class="footer__heading footer__heading--plain">
          <span class="footer__thread" aria-hidden="true"></span>
          <span class="footer__heading-text">{t('common.footer.sitemapLabel')}</span>
          <span class="footer__thread" aria-hidden="true"></span>
        </h2>
        <ul class="footer__sitemap-list">
          {
            navItems.map((item) => (
              <li>
                <a class="footer__sitemap-link" href={item.href}>
                  {t(item.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- 5. Copyright -->
    <p class="footer__copyright">{t('common.footer.copyright')}</p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-footer);
    color: var(--color-warm-white);
    /* V2-09: generous top spacing, minimal bottom padding so the
       copyright sits at the very bottom of the website. */
    padding-top: var(--space-section);
    padding-bottom: 1rem;
    margin-top: var(--space-section);
  }

  /* V2-10: only the home teaser opts out of the normal route separation. */
  .footer--flush {
    margin-top: 0;
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-component);
    text-align: center;
  }

  /* ---- Logo ---- */
  .footer__logo {
    display: flex;
    justify-content: center;
  }
  .footer__logo :global(img) {
    display: block;
  }

  /* ---- Columns ----
       V2-09: always stacked vertically (column direction on every
       breakpoint). Generous gap between the three sections. */
  .footer__columns {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4rem);
    width: 100%;
  }

  /* ---- Section heading with thread-line decoration ---- */
  .footer__heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-brand-orange);
    margin-bottom: 1.25rem;
    position: relative;
    width: min(100%, 32rem);
  }

  .footer__heading::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    transform: translateY(-50%);
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--color-brand-orange) 70%, transparent) 14%,
      var(--color-brand-orange) 50%,
      color-mix(in srgb, var(--color-brand-orange) 70%, transparent) 86%,
      transparent
    );
    opacity: 0.75;
  }

  .footer__heading-text {
    position: relative;
    z-index: 1;
    padding-inline: 1rem;
    background: var(--color-footer);
  }

  /* Continuous centred separator: the line is drawn by the heading pseudo-element. */
  .footer__thread {
    display: none;
  }

  /* ---- Contact icons ---- */
  .footer__contact-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }

  .footer__icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    transition: transform var(--duration-base) var(--ease-luxury);
  }

  .footer__icon-frame {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
  }

  .footer__icon {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 31px;
    max-height: 31px;
    object-fit: contain;
    object-position: center;
    /* Keep source PNG colors untouched: no filter, tint, opacity, mask or blend mode. */
  }

  .footer__icon-link:hover,
  .footer__icon-link:focus-visible {
    transform: translateY(-2px);
  }

  /* ---- Trajet items ---- */
  .footer__trajet-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  .footer__trajet-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
  }
  .footer__trajet-icon {
    min-width: 44px;
  }
  .footer__trajet-label {
    font-size: var(--text-sm);
    color: rgba(248, 246, 243, 0.85);
    text-align: left;
    text-wrap: balance;
  }

  /* ---- Sitemap ---- */
  .footer__sitemap-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }
  .footer__sitemap-link {
    display: inline-block;
    min-height: 44px;
    padding: 0.5rem 0.25rem;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(248, 246, 243, 0.85);
    transition: color var(--duration-base) var(--ease-luxury);
  }
  .footer__sitemap-link:hover,
  .footer__sitemap-link:focus-visible {
    color: var(--color-brand-orange);
  }

  /* ---- Copyright ---- */
  .footer__copyright {
    margin-top: 0.5rem;
    font-size: var(--text-xs);
    color: rgba(248, 246, 243, 0.6);
    text-align: center;
    max-width: 32rem;
    line-height: 1.5;
  }

  /* ---- Desktop layout (md+) ----
     V2-09: sections stay stacked vertically (not horizontal columns).
     Only minor refinements: constrain the stacked content width and
     keep everything centered for an elegant composition. */
  @media (min-width: 768px) {
    .footer__columns {
      max-width: 36rem;
    }
    .footer__copyright {
      max-width: 40rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__icon-link,
    .footer__sitemap-link {
      transition: none;
    }
  }
</style>
