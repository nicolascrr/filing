---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/PageHero.astro';
import BigCarousel from '../components/ui/BigCarousel.astro';
import CatalogueMasonry from '../components/ui/CatalogueMasonry.astro';
import { galleryManifest } from '../server/galleryCatalogue';
import pageHeroGalerie from '../assets/hero/showroom-lead.jpg';

const t = Astro.locals.t;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const manifest = await galleryManifest(Astro.url.searchParams, Astro.locals.locale, t);
const strings = {
  reset: t('ui.gallery.reset'),
  empty: t('ui.gallery.empty'),
  zoomHelp: t('ui.photo.zoomHelp'),
  loading: t('ui.photo.loading'),
  error: t('ui.photo.error'),
  retry: t('ui.photo.retry'),
  close: t('common.gallery.closeLabel'),
  prev: t('common.bigcarousel.prevLabel'),
  next: t('common.bigcarousel.nextLabel'),
  type: t('ui.gallery.type'),
  sample: t('ui.gallery.sample'),
};
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
const category = manifest.categories.find((c) => c.key === manifest.category);
---

<BaseLayout title={`${t('galerie.hero.title')} — ${t('common.brand.name')}`}>
  <Hero image={pageHeroGalerie} title={t('galerie.hero.title')} />
  <section class="content-max catalogue" data-gallery-root aria-label={t('galerie.selector.label')}>
    <nav class="catalogue-nav" aria-label={t('galerie.selector.label')}>
      <button type="button" data-gallery-reset data-hover-slide aria-pressed={!category}
        ><span data-category-arrival
          ><span data-category-click
            ><span data-hover-slide-content>{t('ui.gallery.allCategories')}</span></span
          ></span
        ></button
      >
      {
        manifest.categories.map((c) => (
          <button
            type="button"
            data-gallery-category={c.key}
            data-hover-slide
            aria-pressed={category?.key === c.key}
          >
            <span data-category-arrival>
              <span data-category-click>
                <span data-hover-slide-content>{c.label}</span>
              </span>
            </span>
          </button>
        ))
      }
    </nav>
    <header class="catalogue-heading" hidden={!category}>
      <h2 data-gallery-heading>{category?.label}</h2>
    </header>
    <p data-gallery-status role="status" aria-live="polite">
      {category?.typeCount === 0 ? strings.empty : ''}
    </p>
    <button type="button" data-gallery-retry hidden>{strings.retry}</button>
    <CatalogueMasonry cards={manifest.cards} />
    <BigCarousel strings={strings} />
    <script is:inline type="application/json" data-gallery-manifest set:html={json(manifest)} />
    <script is:inline type="application/json" data-gallery-strings set:html={json(strings)} />
  </section>
</BaseLayout>

<style>
  .catalogue {
    max-width: none;
    padding-inline: clamp(1rem, 2vw, 2rem);
    padding-block: clamp(1rem, 2vw, 2rem) var(--space-section);
  }
  .catalogue-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.8rem;
    padding-block: 0.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 3rem);
  }
  .catalogue button {
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    cursor: pointer;
  }
  .catalogue-nav button {
    --hover-slide-duration: 0.3s;
    min-width: 44px;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    border: 0;
    color: var(--color-charcoal);
  }
  .catalogue-nav button[aria-pressed='true'] {
    --hover-slide-bg: var(--color-brand-orange);
    --hover-slide-radius: var(--radius-sm);
    color: var(--color-charcoal);
  }
  .catalogue-nav [data-category-arrival],
  .catalogue-nav [data-category-click],
  .catalogue-nav [data-hover-slide-content] {
    display: inline-block;
  }
  /* A focused category must be readable immediately, even during a hover. */
  .catalogue-nav button:focus-visible [data-hover-slide-content] {
    animation: none;
  }
  .catalogue-nav button:focus-visible {
    outline: 2px solid var(--color-charcoal);
    outline-offset: 3px;
  }
  .catalogue-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block: 1.5rem 1rem;
  }
  .catalogue-heading h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    text-wrap: balance;
  }
  .catalogue-heading[hidden] {
    display: none;
  }
  .catalogue-heading button {
    background: none;
    border: 1px solid color-mix(in srgb, var(--color-charcoal) 20%, transparent);
  }
  [data-gallery-status]:empty {
    display: none;
  }
  [data-gallery-status] {
    padding-block: 1rem;
  }
</style>
<script>
  import '../scripts/galleryController';
</script>
