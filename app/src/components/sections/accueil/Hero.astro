---
/**
 * Hero (Accueil) — US-12
 *
 * Headerless, fullscreen hero with a looping background video. Breaks out
 * of `--content-max` (full-width, full-bleed).
 *
 * Video:
 *   The mobile and desktop MP4s are imported from `src/assets/hero/`.
 *   Native source selection loads only the matching viewport's video. The
 *   imported poster remains the visual fallback when playback is unavailable.
 *
 * Overlay layout:
 *   - Logo top-center (Astro `<Image>`).
 *   - Menu trigger top-right (already fixed by BaseLayout — not re-added).
 *   - A compact home-only language selector at top-left.
 *   - Tagline centered near the bottom (real text in the DOM, from i18n).
 *
 * Responsive (mobile-first):
 *   - Video fills with `object-fit: cover`.
 *   - Logo and tagline scale down on mobile via fluid sizing.
 *   - The home language selector remains clear of the centred logo on mobile.
 *
 * Accessibility:
 *   - The video is decorative: `aria-hidden="true"`, `tabindex="-1"`, muted,
 *     `playsinline`. It is NOT a focus trap.
 *   - The tagline is real text in the DOM (screen-reader accessible).
 *   - A dark gradient scrim ensures white text/logo stay legible.
 */

import { Image, getImage } from 'astro:assets';
import logo from '../../../assets/brand/logo-orange-shadow.svg';
import LanguageSwitcher from '../../chrome/LanguageSwitcher.astro';
// ffmpeg is not available in the project environment. This supplied client
// photograph is therefore used as the honest, real-image poster fallback.
import heroPoster from '../../../assets/hero/hero-poster.JPG';
import heroVideo from '../../../assets/hero/hero-video.mp4?url';
import heroVideoMobile from '../../../assets/hero/hero-video-mobile.mp4?url';

const t = Astro.locals.t;
const tagline = t('accueil.hero.tagline');
const fallbackPoster = await getImage({ src: heroPoster, width: 1920, format: 'webp' });
---

<section class="hero" aria-label={tagline}>
  <img data-hero-fallback data-src={fallbackPoster.src} alt="" class="hero__poster" />
  <noscript><img src={fallbackPoster.src} alt="" class="hero__poster" /></noscript>
  <!-- Background video (decorative) with a poster fallback. -->
  <video
    class="hero__video"
    data-hero-media
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src={heroVideoMobile} type="video/mp4" media="(max-width: 767.98px)" />
    <source src={heroVideo} type="video/mp4" />
  </video>

  <!-- Dark gradient scrim for legibility of white text/logo. -->
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__languages">
    <LanguageSwitcher class="hero__language-switcher" />
  </div>

  <!-- Logo: top-center. -->
  <div class="hero__logo">
    <Image
      src={logo}
      alt={t('common.brand.name')}
      width={220}
      height={220 * (logo.height / logo.width)}
      loading="eager"
      class="hero__logo-img"
    />
  </div>

  <!-- Desktop tagline starts only after 25% of the hero has scrolled away.
       Kept out of the global reveal selector to avoid an arrival autoplay. -->
  <h1 class="hero__tagline" data-hero-tagline>
    {tagline}
  </h1>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 100vh;
    overflow: hidden;
    background: var(--color-charcoal); /* fallback behind poster/video */
  }

  .hero__poster,
  .hero :global(.hero__first-frame),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero :global(.hero__first-frame[data-playing='true']) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero__first-frame[data-playing='true']) {
      display: block;
    }
  }

  .hero__poster:not([src]) {
    display: none;
  }

  .hero__video[data-media-failed] {
    visibility: hidden;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.15) 35%,
      rgba(0, 0, 0, 0.35) 75%,
      rgba(0, 0, 0, 0.65) 100%
    );
  }

  /* ---- Logo (top-center) ---- */
  .hero__logo {
    position: absolute;
    top: var(--content-padding);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    justify-content: center;
    max-width: calc(100% - 2 * var(--content-padding) - 19rem);
  }

  .hero__logo-img {
    width: clamp(280px, 60vw, 440px);
    max-width: 100%;
    height: auto;
  }

  .hero__languages {
    position: absolute;
    top: var(--content-padding);
    left: var(--content-padding);
    z-index: 3;
  }

  .hero__language-switcher :global(.lang-switcher__list) {
    height: 44px;
    align-items: center;
    gap: 0.35rem;
  }

  .hero__language-switcher :global(.lang-switcher__btn) {
    width: 44px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    color: var(--color-warm-white);
  }

  .hero__language-switcher :global(.lang-switcher__flag) {
    width: 14px;
    height: 14px;
    object-fit: contain;
    object-position: center;
  }

  .hero__language-switcher :global(.lang-switcher__btn[aria-pressed='true']) {
    box-shadow: none;
    opacity: 1;
  }

  @media (max-width: 639px) {
    .hero__logo {
      top: calc(var(--content-padding) + 5rem);
      max-width: calc(100% - 2 * var(--content-padding));
    }
    .hero__logo-img {
      width: clamp(360px, 104vw, 520px);
    }
  }

  /* ---- Tagline (bottom-center) ---- */
  .hero__tagline {
    position: absolute;
    bottom: clamp(2rem, 8vh, 5rem);
    left: 0;
    right: 0;
    z-index: 2;
    margin: 0;
    padding: 0 var(--content-padding);
    text-align: center;
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(0.875rem, 1.5vw, 1.25rem);
    letter-spacing: clamp(0.18em, 0.4vw, 0.32em);
    text-transform: uppercase;
    text-wrap: balance;
  }

  @supports (height: 100svh) {
    .hero {
      height: 100svh;
      min-height: 100svh;
    }
  }
</style>

<script>
  import { gsap } from '../../../scripts/gsap';
  let cleanup: (() => void) | null = null;

  function initHeroVideo(): void {
    cleanup?.();
    cleanup = null;

    const video = document.querySelector<HTMLVideoElement>('.hero__video');
    if (!video) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const hero = video.closest<HTMLElement>('.hero');
    if (!hero) return;
    const bounds = hero.getBoundingClientRect();
    let visible = bounds.bottom > 0 && bounds.top < window.innerHeight;
    let disposed = false;
    let userPaused = false;
    let automaticPauseEvents = 0;
    let playPending = false;
    let playbackFrame = 0;
    let firstFramePresented = false;
    const canPlay = (): boolean =>
      !disposed && firstFramePresented && video.dataset.mediaReady === 'true' && visible &&
      !document.hidden && !reducedMotion.matches && !userPaused;
    const pause = (): void => {
      if (!video.paused) {
        automaticPauseEvents++;
        video.pause();
      }
    };
    const syncPlayback = (): void => {
      if (!canPlay()) {
        pause();
        if (reducedMotion.matches && video.readyState >= 1 && video.currentTime !== 0) {
          video.currentTime = 0;
        }
        return;
      }
      if (playPending || !video.paused) return;
      playPending = true;
      void video.play()
        .then(() => {
          if (!canPlay()) pause();
        })
        .catch(() => {
          // Autoplay denial leaves the decoded, paused first frame visible.
        })
        .finally(() => { playPending = false; });
    };
    const onPause = (): void => {
      if (automaticPauseEvents) automaticPauseEvents--;
      else userPaused = true;
    };
    const onPlay = (): void => {
      userPaused = false;
      if (!canPlay()) pause();
    };
    const onPlaying = (): void => {
      const firstFrame = hero.querySelector<HTMLCanvasElement>('.hero__first-frame');
      if (firstFrame) firstFrame.dataset.playing = 'true';
    };
    video.addEventListener('pause', onPause);
    video.addEventListener('play', onPlay);
    video.addEventListener('playing', onPlaying);
    const observer = typeof IntersectionObserver === 'undefined' ? null :
      new IntersectionObserver(([entry]) => {
        if (!entry) return;
        visible = entry.isIntersecting;
        syncPlayback();
      });
    observer?.observe(hero);
    document.addEventListener('visibilitychange', syncPlayback);

    // Leave the decoded paused first frame on screen for an initial paint.
    const onMediaReady = (): void => {
      cancelAnimationFrame(playbackFrame);
      playbackFrame = requestAnimationFrame(() => {
        playbackFrame = requestAnimationFrame(() => {
          firstFramePresented = true;
          syncPlayback();
        });
      });
    };
    document.addEventListener('filing:hero-ready', onMediaReady);
    if (video.dataset.mediaReady === 'true') onMediaReady();
    const tagline = hero?.querySelector<HTMLElement>('[data-hero-tagline]');
    const media = gsap.matchMedia();
    media.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {
      if (
        !hero ||
        !tagline ||
        document.documentElement.dataset.suppressArrival === 'true' ||
        document.documentElement.dataset.languageSwitching === 'true'
      )
        return;
      gsap.from(tagline, {
        opacity: 0,
        y: 56,
        duration: 1.1,
        ease: 'power3.out',
        scrollTrigger: {
          id: 'home-hero-tagline',
          trigger: hero,
          start: () => `top+=${hero.offsetHeight * 0.25} top`,
          once: true,
        },
      });
    });
    reducedMotion.addEventListener('change', syncPlayback);
    cleanup = () => {
      disposed = true;
      cancelAnimationFrame(playbackFrame);
      observer?.disconnect();
      document.removeEventListener('visibilitychange', syncPlayback);
      document.removeEventListener('filing:hero-ready', onMediaReady);
      video.removeEventListener('pause', onPause);
      video.removeEventListener('play', onPlay);
      video.removeEventListener('playing', onPlaying);
      media.revert();
      reducedMotion.removeEventListener('change', syncPlayback);
      video.pause();
    };
  }

  document.addEventListener('astro:page-load', initHeroVideo);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
