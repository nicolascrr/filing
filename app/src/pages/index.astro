---
import BaseLayout from '../layouts/BaseLayout.astro';
import { parseBold } from '../i18n/t';
import Hero from '../components/sections/accueil/Hero.astro';
import HomeScrollStroke from '../components/sections/accueil/HomeScrollStroke.astro';
import ImageCard from '../components/ui/ImageCard.astro';
import Timeline from '../components/ui/Timeline.astro';
import ValueBlock from '../components/ui/ValueBlock.astro';
import Teaser from '../components/ui/Teaser.astro';
import { timelineMilestones } from '../data/timeline';
import imageCardCreation from '../assets/photos/home/bouton-creation.jpg';
import imageCardProduction from '../assets/photos/home/bouton-production.jpg';
import teaserImg from '../assets/teaser.png';
// ValueBlock logos — original supplied SVG pictos.
import iconFabrication from '../assets/icons/made_in_france.svg';
import iconPatrimoine from '../assets/icons/EPV_logo.svg';
import iconValeurs from '../assets/icons/valeurs.svg';

const t = Astro.locals.t;
---

<BaseLayout footerFlush>
  <Hero />

  <div class="home-thread-region" data-home-thread-region>
    <HomeScrollStroke />

    <!-- 1. Intro — 2 centered paragraphs with bold segments -->
    <section class="content-max section-intro" aria-label={t('common.sectionLabels.intro')}>
      <div class="section-intro__inner">
        <p
          class="section-intro__p"
          data-reveal
          data-reveal-start="top 80%"
          data-reveal-style="atelier-lines"
          set:html={parseBold(t('accueil.intro.p1'))}
        />
        <p
          class="section-intro__p"
          data-reveal
          data-reveal-start="top 80%"
          data-reveal-style="atelier-lines"
          data-reveal-delay="0.18"
          set:html={parseBold(t('accueil.intro.p2'))}
        />
      </div>
    </section>

    <!-- 2. Services — 2 ImageCards (Création / Production) -->
    <section class="content-max section-services" aria-label={t('common.sectionLabels.services')}>
      <div class="section-services__grid">
        <div data-reveal data-reveal-start="top 80%" data-reveal-delay="0">
          <ImageCard
            title={t('accueil.services.creation')}
            image={imageCardCreation}
            href="/creation"
            titleSize="var(--text-2xl)"
          />
        </div>
        <div data-reveal data-reveal-start="top 80%" data-reveal-delay="0.12">
          <ImageCard
            title={t('accueil.services.production')}
            image={imageCardProduction}
            href="/production"
            objectPosition="center 25%"
            titleSize="var(--text-2xl)"
          />
        </div>
      </div>
    </section>

    <!-- 3. Expertise — centered paragraph with bold segments -->
    <section class="content-max section-expertise" aria-label={t('common.sectionLabels.expertise')}>
      <p
        class="section-expertise__p"
        data-home-thread-terminal-content
        data-reveal
        data-reveal-start="top 80%"
        data-reveal-style="embroidered-words"
        set:html={parseBold(t('accueil.expertise.p1'))}
      />
    </section>
  </div>

  <!-- 4. Timeline — interactive milestone accordion -->
  <section
    class="content-max section-timeline"
    data-home-thread-end
    aria-label={t('common.sectionLabels.timeline')}
  >
    <h2 class="sr-only">{t('common.sectionLabels.timeline')}</h2>
    <Timeline milestones={timelineMilestones} />
  </section>

  <!-- 5. Teaser — full-width call-to-action (breaks content-max) -->
  <Teaser
    title={t('accueil.teaser.title')}
    url="/galerie"
    image={teaserImg}
    objectPosition="center top"
    mobileObjectPosition="center top"
    animateTitle
    titleRevealPace="slow"
  />

  <!-- 6. Company values — 3 ValueBlocks -->
  <section class="content-max section-values" aria-label={t('common.sectionLabels.values')}>
    <h2 class="sr-only">{t('common.sectionLabels.values')}</h2>
    <div class="section-values__grid">
      <div>
        <ValueBlock
          logo={iconFabrication}
          logoVariant="orange"
          title={t('accueil.values.fabrication.title')}
          description={t('accueil.values.fabrication.description')}
        />
      </div>
      <div>
        <ValueBlock
          logo={iconPatrimoine}
          logoVariant="orange"
          title={t('accueil.values.patrimoine.title')}
          description={t('accueil.values.patrimoine.description')}
        />
      </div>
      <div>
        <ValueBlock
          logo={iconValeurs}
          logoVariant="orange"
          logoScale={0.8}
          offsetY={-14}
          title={t('accueil.values.valeurs.title')}
          description={t('accueil.values.valeurs.description')}
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-thread-region {
    --home-thread-decorative-layer: 0;
    --home-thread-content-layer: 1;

    position: relative;
    isolation: isolate;
    width: 100%;
    overflow-x: clip;
    overflow-y: visible;
  }

  .home-thread-region > section {
    position: relative;
    z-index: var(--home-thread-content-layer);
  }

  /* ---- Shared section rhythm ---- */
  .section-intro,
  .section-services,
  .section-expertise,
  .section-timeline,
  .section-values {
    padding-block: var(--space-section);
  }

  /* ---- Intro ---- */
  .section-intro__inner {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-intro__p {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-charcoal);
    text-wrap: pretty;
  }

  .section-intro__p :global(strong) {
    font-weight: 600;
    color: var(--color-charcoal);
  }

  /* ---- Services ---- */
  .section-services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-component);
  }

  @media (min-width: 768px) {
    .section-services__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---- Expertise ---- */
  .section-expertise__p {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-charcoal);
    text-wrap: pretty;
  }

  .section-expertise__p :global(strong) {
    font-weight: 600;
    color: var(--color-charcoal);
  }

  /* ---- Values ---- */
  .section-values {
    padding-top: calc(var(--space-section) * 0.55);
  }
  .section-values__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-component);
  }

  .section-values__grid > div {
    display: flex;
    height: 100%;
  }

  .section-values__grid > div :global(.value-block) {
    width: 100%;
  }

  @media (min-width: 768px) {
    .section-values__grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
    }
  }
</style>
