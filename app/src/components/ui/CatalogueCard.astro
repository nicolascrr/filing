---
import type { GalleryCard } from '../../data/galleryTypes';
interface Props {
  card: GalleryCard;
}
const { card } = Astro.props;
---

<button
  type="button"
  class="catalogue-card"
  aria-label={`${card.categoryLabel} · ${card.label}`}
  data-gallery-card
  data-category={card.category}
  data-type={card.type}
  data-image={card.image}
>
  <span data-card-motion>
    <img
      src={card.photo.src}
      srcset={card.photo.srcset}
      sizes={card.photo.sizes}
      width={card.photo.width}
      height={card.photo.height}
      alt={card.photo.alt}
      loading="lazy"
      decoding="async"
      draggable="false"
    />
  </span>
</button>
<style is:global>
  .catalogue-card {
    display: block;
    width: 100%;
    background: none;
    border: 0;
    padding: 0 !important;
    text-align: left;
    cursor: pointer;
    color: var(--color-charcoal);
  }
  .catalogue-card img {
    width: 100%;
    height: auto;
    display: block;
    background: var(--color-warm-white);
  }
  .catalogue-card [data-card-motion] {
    display: block;
  }
  .catalogue-card:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }
</style>
