---
import CatalogueCard from './CatalogueCard.astro';
import type { GalleryCard } from '../../data/galleryTypes';
interface Props {
  cards: GalleryCard[];
  hidden?: boolean;
  class?: string;
}
const { cards, hidden = false, class: className } = Astro.props;
---

<div
  class:list={['catalogue-rail', className]}
  data-gallery-rail
  hidden={hidden}
  role="region"
  aria-label={Astro.locals.t('common.carousel.regionLabel')}
>
  {cards.map((card) => <CatalogueCard card={card} />)}
</div>
<style is:global>
  .catalogue-rail {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block: 1rem;
  }
  .catalogue-rail::-webkit-scrollbar {
    display: none;
  }
  .catalogue-rail[hidden] {
    display: none;
  }
  .catalogue-rail > .catalogue-card {
    flex: 0 0 min(78vw, 440px);
    scroll-snap-align: start;
  }
  @media (min-width: 768px) {
    .catalogue-rail > .catalogue-card {
      flex-basis: min(40vw, 440px);
    }
  }
</style>
