---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface CarouselImage {
  src: ImageMetadata;
  alt: string;
}
export interface Props {
  images: CarouselImage[];
  class?: string;
}

const { images, class: className } = Astro.props;
const t = Astro.locals.t;
const loopImages = Array.from({ length: 3 }, (_, sequence) =>
  images.map((image) => ({ image, sequence })),
).flat();
---

<section
  class:list={['small-carousel', className]}
  aria-label={t('common.carousel.regionLabel')}
  data-small-carousel
>
  <div
    class="small-carousel__track"
    role="region"
    aria-label={t('common.carousel.regionLabel')}
    data-small-carousel-track
  >
    {
      loopImages.map(({ image, sequence }, index) => {
        const duplicate = sequence !== 1;
        return (
          <figure
            class="small-carousel__item"
            data-small-carousel-item
            data-sequence={sequence}
            aria-hidden={duplicate ? 'true' : undefined}
          >
            <button
              type="button"
              class="small-carousel__thumb"
              data-small-carousel-trigger
              data-index={index % images.length}
              aria-label={
                duplicate ? undefined : `${t('common.carousel.openLabel')} — ${image.alt}`
              }
              aria-hidden={duplicate ? 'true' : undefined}
              tabindex={duplicate ? '-1' : undefined}
            >
              <Image
                src={image.src}
                alt={duplicate ? '' : image.alt}
                draggable="false"
                widths={[400, 800]}
                sizes="(max-width: 767px) 78vw, (max-width: 1023px) 52vw, 32vw"
                class="small-carousel__img"
                loading="lazy"
              />
            </button>
          </figure>
        );
      })
    }
  </div>

  <div
    class="small-carousel__lightbox"
    data-small-carousel-lightbox
    role="dialog"
    aria-modal="true"
    aria-label={t('common.carousel.dialogLabel')}
    aria-hidden="true"
    hidden
  >
    <div class="small-carousel__backdrop" data-small-carousel-backdrop aria-hidden="true"></div>
    <button
      type="button"
      class="small-carousel__close"
      data-small-carousel-close
      aria-label={t('common.carousel.closeLabel')}
    >
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"
        ><path
          d="M6 6l12 12M18 6L6 18"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          fill="none"></path></svg
      >
    </button>
    <figure class="small-carousel__figure">
      <img class="small-carousel__large" data-small-carousel-large alt="" src="" /><figcaption
        class="small-carousel__caption"
        data-small-carousel-caption
      >
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .small-carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .small-carousel__track {
    display: flex;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    width: max-content;
    overflow: visible;
    padding-block: 0.5rem;
    scroll-snap-type: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }
  .small-carousel__track::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }
  .small-carousel[data-autoscrolling='true'] .small-carousel__track {
    scroll-snap-type: none;
  }
  .small-carousel[data-autoplay-paused='true'] .small-carousel__track {
    scroll-snap-type: none;
  }
  .small-carousel[data-manual-drag='true'] .small-carousel__track {
    scroll-snap-type: none;
  }
  .small-carousel__track:active {
    cursor: grabbing;
  }
  .small-carousel__track:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
    border-radius: var(--radius-md);
  }
  .small-carousel__item {
    flex: 0 0 auto;
    margin: 0;
    scroll-snap-align: center;
  }
  .small-carousel__thumb {
    display: block;
    width: min(78vw, 21rem);
    height: clamp(15rem, 48vw, 20rem);
    min-width: 44px;
    min-height: 44px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-warm-white);
    cursor: inherit;
    transition:
      transform var(--duration-base) var(--ease-luxury),
      box-shadow var(--duration-base) var(--ease-luxury);
    will-change: transform;
  }
  @media (min-width: 768px) {
    .small-carousel__thumb {
      width: min(52vw, 30rem);
      height: clamp(19rem, 33vw, 25rem);
    }
  }
  @media (min-width: 1024px) {
    .small-carousel__thumb {
      width: min(32vw, 34rem);
      height: clamp(21rem, 28vw, 29rem);
    }
  }
  .small-carousel__thumb:hover,
  .small-carousel__thumb:focus-visible {
    transform: scale(1.018);
    box-shadow: var(--shadow-md);
  }
  .small-carousel__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  .small-carousel__lightbox {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
    opacity: 0;
    transform: scale(0.985);
    pointer-events: none;
    transition:
      opacity 0.8s var(--ease-luxury),
      transform 0.8s var(--ease-luxury);
  }
  .small-carousel__lightbox[data-open='true'] {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }
  .small-carousel__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 20, 20, 0.9);
    backdrop-filter: blur(3px);
  }
  .small-carousel__close {
    position: absolute;
    top: clamp(1rem, 4vw, 1.5rem);
    right: clamp(1rem, 4vw, 1.5rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    transition:
      background var(--duration-base) var(--ease-luxury),
      transform var(--duration-base) var(--ease-luxury);
  }
  .small-carousel__close:hover,
  .small-carousel__close:focus-visible {
    background: rgba(255, 255, 255, 0.18);
    transform: scale(1.06);
  }
  .small-carousel__figure {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 92vw;
    max-height: 90svh;
    margin: 0;
  }
  .small-carousel__large {
    width: auto;
    height: auto;
    max-width: 92vw;
    max-height: 78svh;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
  }
  .small-carousel__caption {
    max-width: 92vw;
    color: #fff;
    font-size: var(--text-sm);
    text-align: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .small-carousel__thumb,
    .small-carousel__lightbox,
    .small-carousel__close {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from '../../scripts/gsap';

  type Cleanup = () => void;
  const cleanups: Cleanup[] = [];

  function focusableIn(element: HTMLElement): HTMLElement[] {
    return Array.from(
      element.querySelectorAll<HTMLElement>(
        'button:not([disabled]), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
      ),
    ).filter((item) => item.offsetParent !== null);
  }

  function initCarousel(root: HTMLElement): Cleanup | null {
    if (root.dataset.bound === 'true') return null;
    const track = root.querySelector<HTMLElement>('[data-small-carousel-track]');
    const lightbox = root.querySelector<HTMLElement>('[data-small-carousel-lightbox]');
    const backdrop = root.querySelector<HTMLElement>('[data-small-carousel-backdrop]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-small-carousel-close]');
    const largeImage = root.querySelector<HTMLImageElement>('[data-small-carousel-large]');
    const caption = root.querySelector<HTMLElement>('[data-small-carousel-caption]');
    const triggers = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-small-carousel-trigger]'),
    );
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-small-carousel-item]'));
    if (!track || !lightbox || !backdrop || !closeButton || !largeImage) return null;
    root.dataset.bound = 'true';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const originalTriggers = triggers.filter(
      (trigger) => trigger.closest<HTMLElement>('[data-sequence]')?.dataset.sequence === '1',
    );
    let isOpen = false;
    let lastFocused: HTMLElement | null = null;
    let previousBodyOverflow = '';
    let previousDocumentOverflow = '';
    let previousScrollX = 0;
    let previousScrollY = 0;
    let scrollLocked = false;
    let dragStartX = 0;
    let dragStartXPosition = 0;
    let lastDragX = 0;
    let lastDragTime = 0;
    let dragVelocity = 0;
    let isMouseDragging = false;
    let isPointerDown = false;
    let suppressClick = false;
    let resumeAt = 0;
    let hideTimer: number | undefined;
    let closeTransitionHandler: ((event: TransitionEvent) => void) | undefined;
    let pauseTimer: number | undefined;
    let isHoverPaused = false;
    let isFocusPaused = false;
    let currentX = 0;
    let momentumTween: ReturnType<typeof gsap.to> | undefined;
    let firstFrame = 0;
    let secondFrame = 0;
    let autoplayStarted = false;
    let destroyed = false;
    const autoplaySpeed = 0.95;
    track.tabIndex = 0;
    gsap.set(track, { force3D: true, x: 0 });

    const publishLightboxState = (open: boolean): void => {
      if (open) document.documentElement.dataset.lightboxOpen = 'true';
      else delete document.documentElement.dataset.lightboxOpen;
      document.dispatchEvent(new CustomEvent('site:lightbox-state', { detail: { open } }));
    };

    const sequenceWidth = (): number => {
      const first = items.find((item) => item.dataset.sequence === '0');
      const second = items.find((item) => item.dataset.sequence === '1');
      return first && second ? second.offsetLeft - first.offsetLeft : 0;
    };
    const normalizeX = (value: number): number => {
      const width = sequenceWidth();
      if (width <= 0) return value;
      let normalized = value;
      while (normalized <= -width * 2) normalized += width;
      while (normalized > -width) normalized -= width;
      return normalized;
    };
    const setX = (value: number): void => {
      currentX = normalizeX(value);
      gsap.set(track, { x: currentX, force3D: true });
    };
    const syncCurrentX = (): void => {
      const x = gsap.getProperty(track, 'x');
      currentX = typeof x === 'number' ? normalizeX(x) : currentX;
      gsap.set(track, { x: currentX, force3D: true });
    };
    const stopMomentum = (): void => {
      momentumTween?.kill();
      momentumTween = undefined;
      dragVelocity = 0;
    };
    const isAutoplayPaused = (): boolean =>
      isHoverPaused ||
      isFocusPaused ||
      isPointerDown ||
      momentumTween !== undefined ||
      isOpen ||
      performance.now() < resumeAt;
    const syncPauseState = (): void => {
      if (isAutoplayPaused()) {
        root.dataset.autoplayPaused = 'true';
        delete root.dataset.autoscrolling;
      } else {
        delete root.dataset.autoplayPaused;
      }
    };
    const pause = (delay = 1100): void => {
      syncCurrentX();
      resumeAt = performance.now() + delay;
      syncPauseState();
      window.clearTimeout(pauseTimer);
      if (Number.isFinite(delay)) {
        pauseTimer = window.setTimeout(() => {
          syncPauseState();
        }, delay);
      }
    };
    const setHoverPaused = (paused: boolean): void => {
      syncCurrentX();
      isHoverPaused = paused;
      if (!paused) resumeAt = performance.now();
      syncPauseState();
    };
    const setFocusPaused = (paused: boolean): void => {
      syncCurrentX();
      isFocusPaused = paused;
      if (!paused) resumeAt = performance.now();
      syncPauseState();
    };
    const positionLightbox = (): void => {
      const viewport = window.visualViewport;
      lightbox.style.top = `${window.scrollY + (viewport?.offsetTop ?? 0)}px`;
      lightbox.style.height = `${viewport?.height ?? window.innerHeight}px`;
    };
    const preventTouchScroll = (event: TouchEvent): void => {
      event.preventDefault();
    };
    const lockScroll = (): void => {
      if (scrollLocked) return;
      scrollLocked = true;
      previousBodyOverflow = document.body.style.overflow;
      previousDocumentOverflow = document.documentElement.style.overflow;
      previousScrollX = window.scrollX;
      previousScrollY = window.scrollY;
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('touchmove', preventTouchScroll, { passive: false });
    };
    const unlockScroll = (): void => {
      if (!scrollLocked) return;
      scrollLocked = false;
      document.body.style.overflow = previousBodyOverflow;
      document.documentElement.style.overflow = previousDocumentOverflow;
      document.removeEventListener('touchmove', preventTouchScroll);
      const previousScrollBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo(previousScrollX, previousScrollY);
      document.documentElement.style.scrollBehavior = previousScrollBehavior;
    };
    const runMomentum = (): void => {
      if (reducedMotion || Math.abs(dragVelocity) < 0.02) {
        stopMomentum();
        syncPauseState();
        return;
      }
      const proxy = { x: currentX };
      momentumTween = gsap.to(proxy, {
        x: currentX + dragVelocity * 420,
        duration: 1.15,
        ease: 'power3.out',
        onUpdate: () => setX(proxy.x),
        onComplete: () => {
          momentumTween = undefined;
          dragVelocity = 0;
          pause(350);
        },
      });
    };
    const autoScroll = (): void => {
      if (destroyed) return;
      const width = sequenceWidth();
      if (width > 0 && currentX === 0) setX(-width);
      if (!isAutoplayPaused() && width > 0) {
        root.dataset.autoscrolling = 'true';
        delete root.dataset.autoplayPaused;
        setX(currentX - autoplaySpeed * Math.min(gsap.ticker.deltaRatio(60), 2));
      } else {
        syncPauseState();
      }
    };
    const beginAutoScroll = (): void => {
      if (reducedMotion || autoplayStarted) return;
      autoplayStarted = true;
      firstFrame = requestAnimationFrame(() => {
        secondFrame = requestAnimationFrame(() => {
          if (destroyed) return;
          const width = sequenceWidth();
          if (width > 0) setX(-width);
          gsap.ticker.add(autoScroll);
        });
      });
    };
    const onDialogKeydown = (event: KeyboardEvent): void => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeLightbox();
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusableIn(lightbox);
      const first = items[0];
      const last = items.at(-1);
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      }
      if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };
    const openLightbox = (trigger: HTMLButtonElement): void => {
      const source = originalTriggers[Number(trigger.dataset.index ?? '0')] ?? trigger;
      const image = source.querySelector<HTMLImageElement>('img');
      if (!image || isOpen) return;
      lastFocused = trigger;
      largeImage.src = image.currentSrc || image.src;
      largeImage.alt = image.alt;
      if (caption) caption.textContent = image.alt;
      lightbox.hidden = false;
      document.body.append(lightbox);
      positionLightbox();
      void lightbox.offsetWidth;
      lightbox.setAttribute('aria-hidden', 'false');
      lightbox.dataset.open = 'true';
      isOpen = true;
      pause(999999);
      lockScroll();
      publishLightboxState(true);
      window.addEventListener('resize', positionLightbox);
      window.visualViewport?.addEventListener('resize', positionLightbox);
      window.visualViewport?.addEventListener('scroll', positionLightbox);
      closeButton.focus({ preventScroll: true });
      document.addEventListener('keydown', onDialogKeydown, true);
    };
    const closeLightbox = (restoreFocus = true, immediate = false): void => {
      if (!isOpen) return;
      isOpen = false;
      delete lightbox.dataset.open;
      lightbox.setAttribute('aria-hidden', 'true');
      window.removeEventListener('resize', positionLightbox);
      window.visualViewport?.removeEventListener('resize', positionLightbox);
      window.visualViewport?.removeEventListener('scroll', positionLightbox);
      document.removeEventListener('keydown', onDialogKeydown, true);
      window.clearTimeout(hideTimer);
      if (closeTransitionHandler) {
        lightbox.removeEventListener('transitionend', closeTransitionHandler);
        closeTransitionHandler = undefined;
      }
      const hide = (): void => {
        if (isOpen || lightbox.hidden) return;
        window.clearTimeout(hideTimer);
        hideTimer = undefined;
        if (closeTransitionHandler) {
          lightbox.removeEventListener('transitionend', closeTransitionHandler);
          closeTransitionHandler = undefined;
        }
        lightbox.hidden = true;
        largeImage.src = '';
        largeImage.alt = '';
        if (caption) caption.textContent = '';
        root.append(lightbox);
        unlockScroll();
        publishLightboxState(false);
        if (restoreFocus) lastFocused?.focus({ preventScroll: true });
      };
      if (immediate || reducedMotion) hide();
      else {
        closeTransitionHandler = (event: TransitionEvent): void => {
          if (event.target !== lightbox || event.propertyName !== 'opacity') return;
          hide();
        };
        lightbox.addEventListener('transitionend', closeTransitionHandler);
        hideTimer = window.setTimeout(hide, 850);
      }
      pause(900);
    };
    const onTrackKeydown = (event: KeyboardEvent): void => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      stopMomentum();
      event.preventDefault();
      const distance =
        event.key === 'ArrowRight' ? -track.clientWidth * 0.75 : track.clientWidth * 0.75;
      if (reducedMotion) setX(currentX + distance);
      else
        gsap.to(track, {
          x: normalizeX(currentX + distance),
          duration: 0.8,
          ease: 'power2.out',
          force3D: true,
          onUpdate: syncCurrentX,
        });
      pause(1400);
    };
    const hold = (event: PointerEvent): void => {
      if (event.pointerType === 'mouse') setHoverPaused(true);
    };
    const release = (event: PointerEvent): void => {
      if (event.pointerType === 'mouse') setHoverPaused(false);
      if (isPointerDown) finishPointerInteraction(event, false);
    };
    const holdFocus = (event: FocusEvent): void => {
      const target = event.currentTarget as HTMLElement;
      setFocusPaused(target.matches(':focus-visible'));
    };
    const releaseFocus = (): void => setFocusPaused(false);
    const onTrackPointerDown = (event: PointerEvent): void => {
      if (event.button !== 0 && event.pointerType === 'mouse') return;
      stopMomentum();
      dragStartX = event.clientX;
      syncCurrentX();
      dragStartXPosition = currentX;
      lastDragX = event.clientX;
      lastDragTime = performance.now();
      dragVelocity = 0;
      isMouseDragging = false;
      isPointerDown = true;
      setFocusPaused(false);
      root.dataset.manualDrag = 'true';
      if (event.isPrimary) track.setPointerCapture(event.pointerId);
    };
    const onTrackPointerMove = (event: PointerEvent): void => {
      if (!track.hasPointerCapture(event.pointerId)) return;
      const now = performance.now();
      const distance = event.clientX - dragStartX;
      if (Math.abs(distance) > 6) isMouseDragging = true;
      if (isMouseDragging) event.preventDefault();
      setX(dragStartXPosition + distance);
      const elapsed = Math.max(now - lastDragTime, 1);
      dragVelocity = (event.clientX - lastDragX) / elapsed;
      lastDragX = event.clientX;
      lastDragTime = now;
    };
    const finishPointerInteraction = (event?: PointerEvent, allowMomentum = true): void => {
      if (!isPointerDown) return;
      isPointerDown = false;
      if (event && track.hasPointerCapture(event.pointerId)) {
        track.releasePointerCapture(event.pointerId);
      }
      delete root.dataset.manualDrag;
      suppressClick = isMouseDragging;
      window.setTimeout(() => {
        suppressClick = false;
      }, 220);
      isHoverPaused = false;
      resumeAt = performance.now();
      if (isMouseDragging && allowMomentum) runMomentum();
      else {
        stopMomentum();
        syncPauseState();
      }
    };
    const onTrackPointerUp = (event: PointerEvent): void =>
      finishPointerInteraction(event, event.type === 'pointerup');
    const onLostPointerCapture = (event: PointerEvent): void =>
      finishPointerInteraction(event, false);
    const onWindowBlur = (): void => finishPointerInteraction(undefined, false);
    const onTriggerFocusOut = (): void => {
      window.setTimeout(() => {
        const active = document.activeElement;
        const imageStillFocused =
          active instanceof HTMLElement && triggers.includes(active as HTMLButtonElement);
        if (!imageStillFocused) releaseFocus();
      }, 0);
    };
    const onTrigger = (event: Event): void => {
      if (suppressClick) {
        event.preventDefault();
        return;
      }
      openLightbox(event.currentTarget as HTMLButtonElement);
    };
    const onBackdrop = (event: MouseEvent): void => {
      if (event.target === backdrop) closeLightbox();
    };
    const onClose = (): void => closeLightbox();
    track.addEventListener('keydown', onTrackKeydown);
    track.addEventListener('pointerdown', onTrackPointerDown);
    track.addEventListener('pointermove', onTrackPointerMove);
    track.addEventListener('pointerup', onTrackPointerUp);
    track.addEventListener('pointercancel', onTrackPointerUp);
    track.addEventListener('lostpointercapture', onLostPointerCapture);
    window.addEventListener('pointerup', onTrackPointerUp);
    window.addEventListener('pointercancel', onTrackPointerUp);
    window.addEventListener('blur', onWindowBlur);
    root.addEventListener('pointerenter', hold);
    root.addEventListener('pointerleave', release);
    triggers.forEach((trigger) => {
      trigger.addEventListener('focusin', holdFocus);
      trigger.addEventListener('focusout', onTriggerFocusOut);
    });
    triggers.forEach((trigger) => trigger.addEventListener('click', onTrigger));
    closeButton.addEventListener('click', onClose);
    backdrop.addEventListener('click', onBackdrop);
    beginAutoScroll();
    return () => {
      destroyed = true;
      closeLightbox(false, true);
      window.clearTimeout(hideTimer);
      if (closeTransitionHandler) {
        lightbox.removeEventListener('transitionend', closeTransitionHandler);
        closeTransitionHandler = undefined;
      }
      window.clearTimeout(pauseTimer);
      window.cancelAnimationFrame(firstFrame);
      window.cancelAnimationFrame(secondFrame);
      stopMomentum();
      gsap.ticker.remove(autoScroll);
      gsap.killTweensOf(track);
      delete root.dataset.autoscrolling;
      delete root.dataset.autoplayPaused;
      track.removeEventListener('keydown', onTrackKeydown);
      track.removeEventListener('pointerdown', onTrackPointerDown);
      track.removeEventListener('pointermove', onTrackPointerMove);
      track.removeEventListener('pointerup', onTrackPointerUp);
      track.removeEventListener('pointercancel', onTrackPointerUp);
      track.removeEventListener('lostpointercapture', onLostPointerCapture);
      window.removeEventListener('pointerup', onTrackPointerUp);
      window.removeEventListener('pointercancel', onTrackPointerUp);
      window.removeEventListener('blur', onWindowBlur);
      root.removeEventListener('pointerenter', hold);
      root.removeEventListener('pointerleave', release);
      triggers.forEach((trigger) => {
        trigger.removeEventListener('focusin', holdFocus);
        trigger.removeEventListener('focusout', onTriggerFocusOut);
      });
      triggers.forEach((trigger) => trigger.removeEventListener('click', onTrigger));
      closeButton.removeEventListener('click', onClose);
      backdrop.removeEventListener('click', onBackdrop);
      window.removeEventListener('resize', positionLightbox);
      window.visualViewport?.removeEventListener('resize', positionLightbox);
      window.visualViewport?.removeEventListener('scroll', positionLightbox);
      document.removeEventListener('touchmove', preventTouchScroll);
      root.dataset.bound = 'false';
    };
  }
  function bindCarousels(): void {
    cleanups.splice(0).forEach((cleanup) => cleanup());
    document.querySelectorAll<HTMLElement>('[data-small-carousel]').forEach((root) => {
      const cleanup = initCarousel(root);
      if (cleanup) cleanups.push(cleanup);
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindCarousels, { once: true });
  } else {
    bindCarousels();
  }
  document.addEventListener('astro:page-load', bindCarousels);
  document.addEventListener('astro:before-swap', () => {
    cleanups.splice(0).forEach((cleanup) => cleanup());
  });
</script>
