---
interface Props {
  strings: Record<string, string>;
}
const { strings: s } = Astro.props;
---

<template data-gallery-viewer-template>
  <div
    class="catalogue-viewer"
    data-gallery-viewer
    role="dialog"
    aria-modal="true"
    aria-labelledby="catalogue-viewer-title"
    aria-describedby="catalogue-zoom-help"
    tabindex="-1"
  >
    <div class="catalogue-viewer__panel">
      <h2 class="sr-only" id="catalogue-viewer-title" data-viewer-title>{s.sample}</h2>
      <p class="sr-only" id="catalogue-zoom-help">{s.zoomHelp}</p>
      <button type="button" data-viewer-close aria-label={s.close}>×</button>
      <div class="catalogue-viewer__stage" data-viewer-stage>
        <img data-viewer-photo alt="" draggable="false" />
      </div>
      <div class="catalogue-viewer__controls">
        <button type="button" data-viewer-prev aria-label={s.prev}>←</button>
        <button type="button" data-viewer-next aria-label={s.next}>→</button>
      </div>
      <div class="catalogue-viewer__feedback">
        <p data-viewer-status role="status" aria-live="polite"></p>
        <button type="button" data-viewer-retry hidden>{s.retry}</button>
      </div>
    </div>
  </div>
</template>
<style is:global>
  .catalogue-viewer {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgb(18 18 18 / 94%);
    color: #f8f5ef;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    overscroll-behavior: contain;
  }
  .catalogue-viewer__panel {
    width: min(100%, 1600px);
    max-height: calc(100dvh - 1rem);
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .catalogue-viewer button {
    min-height: 44px;
    min-width: 44px;
    padding: 0.6rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: 1.5rem;
  }
  .catalogue-viewer button:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: -2px;
  }
  .catalogue-viewer button:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .catalogue-viewer [data-viewer-close] {
    align-self: flex-end;
    flex-shrink: 0;
  }
  .catalogue-viewer__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    height: calc(100dvh - 170px);
    min-height: 0;
    flex-shrink: 1;
    touch-action: none;
  }
  .catalogue-viewer__stage img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    user-select: none;
    cursor: zoom-in;
  }
  .catalogue-viewer__stage[data-zoomed] img {
    cursor: grab;
  }
  .catalogue-viewer__controls {
    display: flex;
    flex-shrink: 0;
    justify-content: center;
    gap: 1rem;
    margin-top: 12px;
  }
  .catalogue-viewer__feedback {
    text-align: center;
    min-height: 1.5rem;
    flex-shrink: 0;
  }
  .catalogue-viewer__feedback p:empty {
    display: none;
  }
  .catalogue-viewer [data-viewer-retry] {
    font-size: 1rem;
  }
  .catalogue-viewer[aria-busy='true'] [data-viewer-photo] {
    opacity: 0.5;
  }
  .catalogue-viewer [hidden] {
    display: none !important;
  }
  @media (max-width: 1023px) {
    .catalogue-viewer__stage img {
      height: 100%;
    }
  }
  @media (min-width: 1024px) {
    .catalogue-viewer__controls {
      margin-top: 0;
    }
    .catalogue-viewer__stage {
      height: calc(100dvh - 100px);
      margin-inline: 60px;
    }
    .catalogue-viewer__controls button {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
    }
    .catalogue-viewer [data-viewer-prev] {
      left: 0;
    }
    .catalogue-viewer [data-viewer-next] {
      right: 0;
    }
  }
</style>
