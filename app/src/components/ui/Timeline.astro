---
import { Image } from 'astro:assets';
import type { TimelineMilestone } from '../../data/timeline';
/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- Focusable articles preview milestones without acting as buttons. */

export interface Props {
  milestones: TimelineMilestone[];
  class?: string;
}

const { milestones, class: className } = Astro.props;
const t = Astro.locals.t;
const regionLabel = t('accueil.timeline.regionLabel');
---

{
  milestones.length > 0 && (
    <section class:list={['timeline', className]} aria-label={regionLabel} data-timeline>
      <div class="timeline__stage" data-timeline-stage>
        <ol class="timeline__list" data-timeline-list>
          {milestones.map((milestone, index) => (
            <li class="timeline__item" data-timeline-item>
              <article
                class="timeline__card"
                tabindex="0"
                aria-current={index === 0 ? 'step' : undefined}
                data-active={index === 0 ? 'true' : 'false'}
                data-index={index}
                data-timeline-card
              >
                <Image
                  src={milestone.image}
                  alt={t(milestone.imageAltKey)}
                  widths={[320, 480, 720, 960]}
                  sizes="(max-width: 1023px) 18.125rem, (max-width: 1279px) 26vw, 420px"
                  class="timeline__image"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
                <div class="timeline__scrim" aria-hidden="true" />
                <div class="timeline__content">
                  <h3 class="timeline__year">
                    <span class="timeline__year-value">{milestone.year}</span>
                  </h3>
                  <p class="timeline__description">{t(milestone.textKey)}</p>
                </div>
              </article>
            </li>
          ))}
        </ol>
        <div class="timeline__controls">
          <button
            type="button"
            class="timeline__arrow"
            data-timeline-previous
            aria-label={t('ui.timeline.previous')}
          >
            <svg viewBox="0 0 28 16" aria-hidden="true" focusable="false">
              <path d="M27 8H2m6-6L2 8l6 6" />
            </svg>
          </button>
          <input
            class="timeline__range"
            data-timeline-range
            type="range"
            min="0"
            max={milestones.length - 1}
            step="any"
            value="0"
            aria-label={t('ui.timeline.range')}
            aria-valuetext={String(milestones[0]?.year)}
          />
          <output class="timeline__position" data-timeline-position aria-hidden="true">
            {milestones[0]?.year}
          </output>
          <button
            type="button"
            class="timeline__arrow"
            data-timeline-next
            aria-label={t('ui.timeline.next')}
          >
            <svg viewBox="0 0 28 16" aria-hidden="true" focusable="false">
              <path d="M1 8h25m-6-6 6 6-6 6" />
            </svg>
          </button>
        </div>
      </div>
    </section>
  )
}

<style>
  .timeline__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: min(100%, 36rem);
    margin: 1rem auto 0;
    padding-inline: var(--content-padding);
  }
  .timeline__arrow {
    min-width: 44px;
    min-height: 44px;
    font-size: 1.5rem;
    color: var(--color-charcoal);
    border: 0;
    background: transparent;
    box-shadow: none;
    transition: color 0.35s ease;
  }
  .timeline__arrow svg {
    display: block;
    width: 28px;
    height: 16px;
    margin: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    transition: transform 0.35s ease;
  }
  .timeline__arrow:not(:disabled):is(:hover, :focus-visible) {
    color: var(--color-brand-orange);
  }
  .timeline__arrow:focus-visible {
    outline: none;
  }
  .timeline__arrow[data-timeline-previous]:not(:disabled):is(:hover, :focus-visible) svg {
    transform: translateX(-3px);
  }
  .timeline__arrow[data-timeline-next]:not(:disabled):is(:hover, :focus-visible) svg {
    transform: translateX(3px);
  }
  .timeline__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .timeline__position {
    min-width: 4ch;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--color-charcoal) 75%, transparent);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }
  .timeline__range {
    appearance: none;
    min-width: 0;
    width: 100%;
    height: 44px;
    background: transparent;
    cursor: pointer;
    touch-action: none;
  }
  .timeline__range::-webkit-slider-runnable-track {
    height: 3px;
    background:
      conic-gradient(from 45deg at 0 50%, #a77c4e 0deg 90deg, transparent 90deg) left center / 8px 3px no-repeat,
      linear-gradient(to bottom, #a79c8b, var(--color-charcoal) 50%, #a77c4e) right center / calc(100% - 8px) 3px no-repeat;
  }
  .timeline__range::-moz-range-track {
    height: 3px;
    background:
      conic-gradient(from 45deg at 0 50%, #a77c4e 0deg 90deg, transparent 90deg) left center / 8px 3px no-repeat,
      linear-gradient(to bottom, #a79c8b, var(--color-charcoal) 50%, #a77c4e) right center / calc(100% - 8px) 3px no-repeat;
  }
  .timeline__range::-webkit-slider-thumb {
    appearance: none;
    box-sizing: border-box;
    width: 14px;
    height: 26px;
    margin-top: -11.5px;
    border: 2px solid var(--color-brand-orange);
    border-radius: 50%;
    background: transparent;
    box-shadow: 0 0 0 2px var(--color-warm-white);
  }
  .timeline__range::-moz-range-thumb {
    box-sizing: border-box;
    width: 14px;
    height: 26px;
    border: 2px solid var(--color-brand-orange);
    border-radius: 50%;
    background: transparent;
    box-shadow: 0 0 0 2px var(--color-warm-white);
  }
  .timeline {
    /* Change collapsed/expanded dimensions here. */
    --timeline-card-expanded: 420px;
    --timeline-card-collapsed: 80px;
    --timeline-card-mobile: 290px;
    --timeline-card-height: 290px;
    --timeline-card-gap: 8px;
    --timeline-card-radius: 20px;
    /* Change the non-scroll transition duration/easing here. */
    --timeline-duration: 0.58;
    --timeline-ease: power2.out;
    width: 100%;
    min-width: 0;
  }

  .timeline__stage {
    width: 100%;
  }

  .timeline__list {
    display: flex;
    gap: var(--timeline-card-gap);
    width: 100%;
    margin: 0;
    padding: 0 var(--content-padding) 0.75rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: var(--content-padding);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
  }

  .timeline__list::-webkit-scrollbar {
    display: none;
  }

  .timeline__item {
    flex: 0 0 var(--timeline-card-mobile);
    min-width: 0;
    scroll-snap-align: center;
  }

  .timeline__card {
    position: relative;
    display: flex;
    min-height: var(--timeline-card-height);
    overflow: hidden;
    border-radius: var(--timeline-card-radius);
    background: var(--color-charcoal);
    color: #fff;
    isolation: isolate;
    outline: none;
  }

  .timeline__card:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }

  .timeline__image,
  .timeline__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .timeline__image {
    z-index: -2;
    object-fit: cover;
    filter: grayscale(0.64) brightness(0.58);
    transform: scale(1.02);
  }

  .timeline__scrim {
    z-index: -1;
    background: linear-gradient(180deg, rgba(15, 14, 12, 0.04), rgba(15, 14, 12, 0.86));
  }

  .timeline__content {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    width: 100%;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
  }

  .timeline__year,
  .timeline__description {
    margin: 0;
  }

  .timeline__year {
    font-family: var(--font-heading);
    font-size: clamp(2.3rem, 11vw, 4rem);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: 0.04em;
    color: #fff;
  }

  .timeline__year-value {
    display: inline-block;
    transform-origin: left bottom;
    will-change: transform, opacity;
  }

  .timeline__description {
    margin-top: 0.75rem;
    font-size: max(1rem, var(--text-sm));
    line-height: 1.55;
    text-wrap: pretty;
  }

  .timeline__card[data-active='true'] .timeline__image {
    filter: grayscale(0) brightness(0.9);
    transform: scale(1.07);
  }

  .timeline__card[data-active='true'] .timeline__scrim {
    background: linear-gradient(180deg, rgba(15, 14, 12, 0.02), rgba(15, 14, 12, 0.78));
  }

  @media (max-width: 767px) {
    .timeline {
      --timeline-card-height: clamp(32rem, 72svh, 40rem);
    }

    .timeline__stage {
      min-height: var(--timeline-card-height);
    }

    .timeline__card {
      height: var(--timeline-card-height);
      min-height: var(--timeline-card-height);
    }
  }

  @media (min-width: 768px) {
    .timeline__year {
      transform: translate(6px, -6px);
    }
  }

  /* Desktop breakpoint: keep this in sync with DESKTOP_MEDIA_QUERY in the script. */
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    /* Larger desktop-only dimensions: the row intentionally fills its container. */
    .timeline {
      --timeline-card-expanded: 520px;
      --timeline-card-collapsed: 96px;
      --timeline-card-height: clamp(30rem, 70vh, 44rem);
    }

    .timeline__stage {
      display: flex;
      min-height: min(82vh, 48rem);
      flex-direction: column;
      justify-content: center;
      padding-block: clamp(1.5rem, 4vh, 3rem);
    }

    .timeline__list {
      gap: var(--timeline-card-gap);
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .timeline__item {
      flex: 1 1 var(--timeline-card-collapsed);
      transform: translateY(0);
    }

    .timeline__item[data-active='true'] {
      transform: translateY(-1.25rem);
    }

    .timeline__card {
      height: var(--timeline-card-height);
      min-height: var(--timeline-card-height);
      opacity: 0.72;
    }

    .timeline__content {
      padding: 0.75rem 0.5rem;
    }

    .timeline__year {
      font-size: 1.25rem;
    }

    .timeline__description {
      position: absolute;
      visibility: hidden;
      max-width: 31ch;
      opacity: 0;
      transform: translateY(1rem);
    }

    .timeline__card[data-active='true'] {
      opacity: 1;
      box-shadow: var(--shadow-lg);
    }

    .timeline__card[data-active='true'] .timeline__scrim {
      background: linear-gradient(180deg, rgba(15, 14, 12, 0.04), rgba(15, 14, 12, 0.86));
    }

    .timeline__card[data-active='true'] .timeline__year {
      font-size: clamp(3rem, 5vw, 5rem);
    }

    .timeline__card[data-active='true'] .timeline__content {
      padding: 1.5rem;
    }

    .timeline__card[data-active='true'] .timeline__description {
      position: static;
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* SSR/no-JS fallback: the accordion is only collapsed by its controller. */
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .timeline:not([data-timeline-enhanced='true']) .timeline__list {
      flex-wrap: wrap;
      overflow: visible;
    }
    .timeline:not([data-timeline-enhanced='true']) .timeline__item {
      flex: 1 1 var(--timeline-card-mobile);
      transform: none;
    }
    .timeline:not([data-timeline-enhanced='true']) .timeline__card {
      height: auto;
      min-height: 22rem;
      opacity: 1;
    }
    .timeline:not([data-timeline-enhanced='true']) .timeline__content {
      position: relative;
      inset: auto;
      padding: 1.5rem;
    }
    .timeline:not([data-timeline-enhanced='true']) .timeline__year {
      font-size: var(--text-3xl);
    }
    .timeline:not([data-timeline-enhanced='true']) .timeline__description {
      position: static;
      visibility: visible;
      opacity: 1;
      transform: none;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline__arrow,
    .timeline__arrow svg {
      transition: none;
    }
    .timeline__arrow:not(:disabled):is(:hover, :focus-visible) svg {
      transform: none;
    }
    .timeline__stage {
      min-height: 0;
    }
    .timeline__list {
      scroll-snap-type: none;
      flex-wrap: wrap;
      overflow: visible;
      padding-inline: var(--content-padding);
    }

    .timeline__item {
      flex: 1 1 var(--timeline-card-mobile);
      transform: none !important;
    }
    .timeline__card {
      height: auto;
      min-height: 22rem;
      opacity: 1;
      overflow: visible;
    }
    .timeline__content {
      position: relative;
      inset: auto;
      padding: 1.5rem;
    }
    .timeline__year {
      font-size: var(--text-3xl);
    }

    .timeline__image {
      filter: grayscale(0) brightness(0.82);
      transform: none;
    }

    .timeline__description {
      position: static;
      visibility: visible;
      max-width: none;
      overflow: visible;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '../../scripts/gsap';

  type Cleanup = () => void;
  type ActiveSource = 'click' | 'focus' | 'touch' | 'scroll' | 'range' | 'initial';
  interface ActiveOptions {
    animate?: boolean;
    force?: boolean;
    rangeValue?: number;
    writeRangeValue?: boolean;
    source: ActiveSource;
  }

  const cleanups: Cleanup[] = [];
  // Desktop breakpoint: keep synchronized with the CSS media query above.
  const DESKTOP_MEDIA_QUERY =
    '(min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)';
  // Preserve the continuous scrub model while making each milestone advance
  // only slightly faster than the previously validated 0.24 viewport distance.
  const SCROLL_VIEWPORT_MULTIPLIER = 0.216;

  function initTimelines(): void {
    cleanups.splice(0).forEach((cleanup) => cleanup());
    document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((root) => {
      cleanups.push(initTimeline(root));
    });
  }

  function initTimeline(root: HTMLElement): Cleanup {
    const stage = root.querySelector<HTMLElement>('[data-timeline-stage]');
    const list = root.querySelector<HTMLOListElement>('[data-timeline-list]');
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-timeline-item]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-timeline-card]'));
    const images = Array.from(root.querySelectorAll<HTMLImageElement>('.timeline__image'));
    const scrims = Array.from(root.querySelectorAll<HTMLElement>('.timeline__scrim'));
    const contents = Array.from(root.querySelectorAll<HTMLElement>('.timeline__content'));
    const years = Array.from(root.querySelectorAll<HTMLElement>('.timeline__year'));
    const yearValues = Array.from(root.querySelectorAll<HTMLElement>('.timeline__year-value'));
    const descriptions = Array.from(root.querySelectorAll<HTMLElement>('.timeline__description'));
    const range = root.querySelector<HTMLInputElement>('[data-timeline-range]');
    const previous = root.querySelector<HTMLButtonElement>('[data-timeline-previous]');
    const next = root.querySelector<HTMLButtonElement>('[data-timeline-next]');
    const position = root.querySelector<HTMLOutputElement>('[data-timeline-position]');

    if (!stage || !list || cards.length === 0 || items.length !== cards.length)
      return () => undefined;

    let activeIndex = 0;
    let desktopAccordion = false;
    let activeAnimation: gsap.core.Timeline | null = null;
    let listAnimation: gsap.core.Tween | null = null;
    let inputOwner: 'range' | 'navigation' | null = null;
    let rangePointerId: number | null = null;
    let rangeNeedsRender = false;
    let lastRangeScroll: number | null = null;
    let restoreRangeScrollBehavior: Cleanup | null = null;
    let syncingScroll = false;
    let mobileTouchInteraction = false;
    const originalScrollSnap = list.style.scrollSnapType;
    let scrollFrame = 0;
    let refreshFrame = 0;
    let refreshQueued = false;
    let desktopTrigger: ReturnType<typeof ScrollTrigger.create> | null = null;
    let media: gsap.MatchMedia | null = null;
    let resizeObserver: ResizeObserver | null = null;
    let disposed = false;
    const incompleteImageLoadListeners: Array<{
      image: HTMLImageElement;
      listener: () => void;
    }> = [];
    const context = gsap.context(() => {
      const getDimension = (
        name: '--timeline-card-expanded' | '--timeline-card-collapsed',
      ): string => getComputedStyle(root).getPropertyValue(name).trim();
      const getAnimationDuration = (): number =>
        Number.parseFloat(getComputedStyle(root).getPropertyValue('--timeline-duration')) || 0.58;
      const getAnimationEase = (): string =>
        getComputedStyle(root).getPropertyValue('--timeline-ease').trim() || 'power2.out';

      /**
       * Single state controller for pointer, focus, touch, and ScrollTrigger.
       * Scroll derives an integer index instead of tweening a master layout;
       * that prevents stale transforms and keeps every input mode deterministic.
       */
      const setActiveMilestone = (nextIndex: number, options: ActiveOptions): void => {
        if (inputOwner === 'range' && options.source !== 'range') return;
        const index = Math.min(Math.max(Math.round(nextIndex), 0), cards.length - 1);
        if (range) {
          if (inputOwner !== 'range' && options.writeRangeValue !== false)
            range.value = String(options.rangeValue ?? index);
          range.setAttribute('aria-valuetext', years[index]?.textContent?.trim() ?? '');
        }
        if (position) position.value = years[index]?.textContent?.trim() ?? '';
        if (previous) previous.disabled = index === 0;
        if (next) next.disabled = index === cards.length - 1;
        if (!options.force && index === activeIndex && cards[index]?.dataset.active === 'true')
          return;

        const currentYearFontSize = years.map((year) => getComputedStyle(year).fontSize);
        const currentCardOpacity = cards.map((card) => getComputedStyle(card).opacity);
        activeIndex = index;
        cards.forEach((card, cardIndex) => {
          const active = cardIndex === index;
          card.dataset.active = String(active);
          if (items[cardIndex]) items[cardIndex].dataset.active = String(active);
          if (active) card.setAttribute('aria-current', 'step');
          else card.removeAttribute('aria-current');
        });

        if (!desktopAccordion) return;

        activeAnimation?.kill();
        const expanded = getDimension('--timeline-card-expanded');
        const collapsed = getDimension('--timeline-card-collapsed');
        const animate = options.animate ?? options.source !== 'scroll';
        // Read CSS's responsive active/inactive font sizes, then restore the
        // current inline values so GSAP can interpolate the year cleanly.
        gsap.set(years, { clearProps: 'fontSize' });
        const targetYearFontSize = years.map((year) => getComputedStyle(year).fontSize);
        gsap.set(years, { fontSize: (itemIndex: number) => currentYearFontSize[itemIndex] });
        gsap.set(cards, { opacity: (itemIndex: number) => currentCardOpacity[itemIndex] });
        const itemBasis = items.map((_, itemIndex) => (itemIndex === index ? expanded : collapsed));
        const imageFilters = cards.map((_, cardIndex) =>
          cardIndex === index ? 'grayscale(0) brightness(0.9)' : 'grayscale(0.64) brightness(0.58)',
        );

        // Flex-basis is the only layout dimension animated: no mixed width system.
        const state = {
          flexBasis: itemBasis,
          filter: imageFilters,
          imageScale: cards.map((_, cardIndex) => (cardIndex === index ? 1.07 : 1.02)),
          cardOpacity: cards.map((_, cardIndex) => (cardIndex === index ? 1 : 0.72)),
          contentOpacity: cards.map((_, cardIndex) => (cardIndex === index ? 1 : 0.72)),
          descriptionOpacity: cards.map((_, cardIndex) => (cardIndex === index ? 1 : 0)),
          descriptionY: cards.map((_, cardIndex) => (cardIndex === index ? 0 : 10)),
          scrimOpacity: cards.map((_, cardIndex) => (cardIndex === index ? 0.78 : 0.86)),
          yearFontSize: targetYearFontSize,
          yearOpacity: cards.map((_, cardIndex) => (cardIndex === index ? 1 : 0.88)),
          yearScale: cards.map((_, cardIndex) => (cardIndex === index ? 1 : 0.97)),
        };

        if (!animate) {
          gsap.set(items, { flexBasis: (itemIndex: number) => state.flexBasis[itemIndex] });
          gsap.set(images, {
            filter: (itemIndex: number) => state.filter[itemIndex],
            scale: (itemIndex: number) => state.imageScale[itemIndex],
          });
          gsap.set(cards, { opacity: (itemIndex: number) => state.cardOpacity[itemIndex] });
          gsap.set(contents, { opacity: (itemIndex: number) => state.contentOpacity[itemIndex] });
          gsap.set(descriptions, {
            autoAlpha: (itemIndex: number) => state.descriptionOpacity[itemIndex],
            y: (itemIndex: number) => state.descriptionY[itemIndex],
          });
          gsap.set(years, { fontSize: (itemIndex: number) => state.yearFontSize[itemIndex] });
          gsap.set(yearValues, {
            opacity: (itemIndex: number) => state.yearOpacity[itemIndex],
            scale: (itemIndex: number) => state.yearScale[itemIndex],
          });
          gsap.set(scrims, { opacity: (itemIndex: number) => state.scrimOpacity[itemIndex] });
          return;
        }

        activeAnimation = gsap
          .timeline({
            defaults: {
              duration: getAnimationDuration(),
              ease: getAnimationEase(),
              overwrite: 'auto',
            },
          })
          .to(items, { flexBasis: (itemIndex: number) => state.flexBasis[itemIndex] }, 0)
          .to(
            images,
            {
              filter: (itemIndex: number) => state.filter[itemIndex],
              scale: (itemIndex: number) => state.imageScale[itemIndex],
            },
            0,
          )
          .to(cards, { opacity: (itemIndex: number) => state.cardOpacity[itemIndex] }, 0)
          .to(contents, { opacity: (itemIndex: number) => state.contentOpacity[itemIndex] }, 0)
          .to(
            descriptions,
            {
              autoAlpha: (itemIndex: number) => state.descriptionOpacity[itemIndex],
              y: (itemIndex: number) => state.descriptionY[itemIndex],
            },
            0,
          )
          .to(years, { fontSize: (itemIndex: number) => state.yearFontSize[itemIndex] }, 0)
          .to(
            yearValues,
            {
              opacity: (itemIndex: number) => state.yearOpacity[itemIndex],
              scale: (itemIndex: number) => state.yearScale[itemIndex],
            },
            0,
          )
          .to(scrims, { opacity: (itemIndex: number) => state.scrimOpacity[itemIndex] }, 0);
      };

      const clampValue = (value: number): number =>
        Math.min(Math.max(value, 0), cards.length - 1);
      const listDestination = (value: number): number => {
        const lower = Math.floor(value);
        const upper = Math.ceil(value);
        const center = (index: number): number => {
          const item = items[index];
          const left = item.offsetLeft - list.offsetLeft - (list.clientWidth - item.clientWidth) / 2;
          return Math.min(Math.max(left, 0), Math.max(0, list.scrollWidth - list.clientWidth));
        };
        const left = center(lower) + (center(upper) - center(lower)) * (value - lower);
        return Math.min(Math.max(left, 0), Math.max(0, list.scrollWidth - list.clientWidth));
      };
      const stopListAnimation = (): void => {
        onRangeEnd();
        listAnimation?.kill();
        listAnimation = null;
        window.cancelAnimationFrame(scrollFrame);
        inputOwner = null;
        lastRangeScroll = null;
        list.style.scrollSnapType = originalScrollSnap;
      };
      const syncPhysicalScroll = (value: number): void => {
        syncingScroll = true;
        try {
          if (desktopTrigger && cards.length > 1) {
            const target = desktopTrigger.start +
              ((desktopTrigger.end - desktopTrigger.start) * value) / (cards.length - 1);
            window.scrollTo({ top: target, behavior: 'instant' });
            if (inputOwner === 'range') lastRangeScroll = window.scrollY;
            ScrollTrigger.update();
          } else if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            list.scrollTo({ left: listDestination(value), behavior: 'instant' });
            if (inputOwner === 'range') lastRangeScroll = list.scrollLeft;
          }
        } finally {
          syncingScroll = false;
        }
      };
      const navigateTo = (nextIndex: number, source: ActiveSource = 'click'): void => {
        if (inputOwner === 'range') return;
        const index = Math.round(clampValue(nextIndex));
        stopListAnimation();
        inputOwner = 'navigation';
        setActiveMilestone(index, { source, animate: true });
        if (desktopTrigger || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // The same slide transition as wheel scroll; its physical destination
          // is written under a guard so ScrollTrigger cannot replace the input.
          syncPhysicalScroll(index);
          inputOwner = null;
        } else {
          list.style.scrollSnapType = 'none';
          listAnimation = gsap.to(list, {
            scrollLeft: listDestination(index),
            duration: getAnimationDuration(),
            ease: getAnimationEase(),
            overwrite: 'auto',
            onComplete: stopListAnimation,
          });
        }
      };
      const beginRange = (): void => {
        if (inputOwner === 'range') return;
        stopListAnimation();
        activeAnimation?.kill();
        activeAnimation = null;
        inputOwner = 'range';
        rangeNeedsRender = true;
        list.style.scrollSnapType = 'none';
        // Leave the thumb and layout untouched until the browser emits input.
      };
      const disableRangeSmoothScroll = (): void => {
        if (restoreRangeScrollBehavior) return;
        const styles = [document.documentElement.style, list.style];
        const originals = styles.map((style) => ({
          value: style.getPropertyValue('scroll-behavior'),
          priority: style.getPropertyPriority('scroll-behavior'),
        }));
        styles.forEach((style) => style.setProperty('scroll-behavior', 'auto', 'important'));
        restoreRangeScrollBehavior = () => {
          styles.forEach((style, index) => {
            const original = originals[index];
            if (original.value) style.setProperty('scroll-behavior', original.value, original.priority);
            else style.removeProperty('scroll-behavior');
          });
        };
      };
      const onRange = (): void => {
        if (!range) return;
        const value = clampValue(Number(range.value));
        const dragging = inputOwner === 'range';
        if (!dragging) beginRange();
        disableRangeSmoothScroll();
        // Range owns both the continuous thumb and physical scroll. Layout is
        // immediate during drag; no old tween may complete after a reversal.
        setActiveMilestone(value, {
          source: 'range', animate: false, force: rangeNeedsRender, writeRangeValue: false,
        });
        rangeNeedsRender = false;
        syncPhysicalScroll(value);
        if (!dragging) onRangeEnd();
      };
      const onRangeEnd = (event?: Event): void => {
        if (inputOwner !== 'range') return;
        if (event instanceof PointerEvent && event.pointerId !== rangePointerId) return;
        rangePointerId = null;
        inputOwner = null;
        rangeNeedsRender = false;
        restoreRangeScrollBehavior?.();
        restoreRangeScrollBehavior = null;
        // Restoring mandatory snap here moves the released position. Native
        // list pointer/wheel interaction, navigation, or cleanup restores it.
        if (desktopAccordion || window.matchMedia('(prefers-reduced-motion: reduce)').matches)
          list.style.scrollSnapType = originalScrollSnap;
        if (refreshQueued) scheduleRefresh();
      };
      const onRangeStart = (event: PointerEvent): void => {
        if (!range || !event.isPrimary || event.button !== 0 || rangePointerId !== null) return;
        beginRange();
        rangePointerId = event.pointerId;
      };
      const onWindowContextLoss = (): void => {
        if (document.hidden) onRangeEnd();
      };
      const onListInteraction = (event: Event): void => {
        if (event instanceof PointerEvent && event.pointerType === 'touch' &&
          window.matchMedia('(max-width: 639px)').matches) mobileTouchInteraction = true;
        if (inputOwner !== 'range') stopListAnimation();
      };
      const onListKey = (): void => { mobileTouchInteraction = false; };
      const onRangeKey = (event: KeyboardEvent): void => {
        if (!range) return;
        let value = Number(range.value);
        switch (event.key) {
          case 'ArrowLeft': case 'ArrowDown': case 'PageDown': value -= 1; break;
          case 'ArrowRight': case 'ArrowUp': case 'PageUp': value += 1; break;
          case 'Home': value = 0; break;
          case 'End': value = cards.length - 1; break;
          default: return;
        }
        event.preventDefault();
        navigateTo(value, 'range');
      };
      const onPrevious = (): void => navigateTo(activeIndex - 1);
      const onNext = (): void => navigateTo(activeIndex + 1);

      const activateNearestCard = (source: 'touch' | 'scroll'): void => {
        if (inputOwner || syncingScroll) return;
        let value = cards.length - 1;
        if (lastRangeScroll === list.scrollLeft && range) {
          value = Number(range.value);
        } else {
          lastRangeScroll = null;
          for (let index = 0; index < cards.length - 1; index += 1) {
            const start = listDestination(index);
            const end = listDestination(index + 1);
            if (list.scrollLeft <= end) {
              value = index + (end > start ? (list.scrollLeft - start) / (end - start) : 0);
              break;
            }
          }
        }
        value = clampValue(value);
        setActiveMilestone(value, { source, animate: true, rangeValue: value });
      };

      const onFocus = (event: FocusEvent): void => {
        const card = event.currentTarget as HTMLElement;
        // Touch focus must not start a scrollLeft tween against native panning.
        // Keyboard focus retains its existing explicit navigation behavior.
        if (window.matchMedia('(max-width: 639px)').matches &&
          (mobileTouchInteraction || !card.matches(':focus-visible'))) return;
        navigateTo(Number(card.dataset.index), 'focus');
      };
      const onTouchEnd = (): void => {
        mobileTouchInteraction = false;
        activateNearestCard('touch');
      };
      const onTouchCancel = (): void => { mobileTouchInteraction = false; };
      const onNativeScroll = (): void => {
        if (desktopAccordion || inputOwner || syncingScroll) return;
        window.cancelAnimationFrame(scrollFrame);
        scrollFrame = window.requestAnimationFrame(() => activateNearestCard('scroll'));
      };
      const scheduleRefresh = (): void => {
        if (disposed) return;
        refreshQueued = true;
        window.cancelAnimationFrame(refreshFrame);
        refreshFrame = 0;
        if (inputOwner === 'range') return;
        refreshFrame = window.requestAnimationFrame(() => {
          refreshFrame = 0;
          if (disposed || inputOwner === 'range') return;
          refreshQueued = false;
          ScrollTrigger.refresh();
        });
      };

      cards.forEach((card) => {
        card.addEventListener('focus', onFocus);
      });
      list.addEventListener('scroll', onNativeScroll, { passive: true });
      list.addEventListener('pointerup', onTouchEnd, { passive: true });
      list.addEventListener('pointercancel', onTouchCancel, { passive: true });
      list.addEventListener('pointerdown', onListInteraction, { passive: true });
      list.addEventListener('wheel', onListInteraction, { passive: true });
      list.addEventListener('keydown', onListKey);
      range?.addEventListener('pointerdown', onRangeStart);
      range?.addEventListener('keydown', onRangeKey);
      window.addEventListener('pointerup', onRangeEnd, true);
      window.addEventListener('pointercancel', onRangeEnd, true);
      window.addEventListener('blur', onRangeEnd);
      document.addEventListener('visibilitychange', onWindowContextLoss);
      range?.addEventListener('input', onRange);
      previous?.addEventListener('click', onPrevious);
      next?.addEventListener('click', onNext);
      setActiveMilestone(0, { source: 'initial', force: true, animate: false });

      media = gsap.matchMedia();
      media.add(DESKTOP_MEDIA_QUERY, () => {
        stopListAnimation();
        desktopAccordion = true;
        root.dataset.timelineEnhanced = 'true';
        setActiveMilestone(activeIndex, { source: 'initial', animate: false, force: true });
        if (cards.length < 2)
          return () => {
            stopListAnimation();
            desktopAccordion = false;
            delete root.dataset.timelineEnhanced;
          };

        desktopTrigger = ScrollTrigger.create({
          trigger: stage,
          start: 'center center',
          end: () => `+=${(cards.length - 1) * window.innerHeight * SCROLL_VIEWPORT_MULTIPLIER}`,
          pin: true,
          pinSpacing: true,
          anticipatePin: 1,
          scrub: true,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (inputOwner || syncingScroll) return;
            const keepRangeValue = lastRangeScroll === self.scroll();
            const value = keepRangeValue && range
              ? Number(range.value) : self.progress * (cards.length - 1);
            if (!keepRangeValue) lastRangeScroll = null;
            setActiveMilestone(value, {
              source: 'scroll',
              animate: true,
              rangeValue: value,
            });
          },
        });
        const onDesktopClick = (event: MouseEvent): void => {
          if (!desktopTrigger || inputOwner === 'range') return;
          const card = event.currentTarget as HTMLElement;
          const index = Number(card.dataset.index);
          // A click can occur while image/font layout has just settled. Refresh
          // before reading start/end so the physical destination is current.
          ScrollTrigger.refresh();
          navigateTo(index);
        };
        cards.forEach((card) => card.addEventListener('click', onDesktopClick));
        return () => {
          stopListAnimation();
          activeAnimation?.kill();
          cards.forEach((card) => card.removeEventListener('click', onDesktopClick));
          desktopTrigger?.kill();
          desktopTrigger = null;
          desktopAccordion = false;
          delete root.dataset.timelineEnhanced;
          gsap.set(
            [
              ...items,
              ...cards,
              ...images,
              ...scrims,
              ...contents,
              ...years,
              ...yearValues,
              ...descriptions,
            ],
            { clearProps: 'all' },
          );
        };
      });

      resizeObserver = new ResizeObserver(scheduleRefresh);
      resizeObserver.observe(stage);
      images.forEach((image) => {
        if (image.complete) return;
        const onImageLoad = (): void => scheduleRefresh();
        incompleteImageLoadListeners.push({ image, listener: onImageLoad });
        image.addEventListener('load', onImageLoad, { once: true });
      });
      void document.fonts?.ready.then(() => {
        if (!disposed) scheduleRefresh();
      });
      scheduleRefresh();

      return () => {
        disposed = true;
        cards.forEach((card) => {
          card.removeEventListener('focus', onFocus);
        });
        list.removeEventListener('scroll', onNativeScroll);
        list.removeEventListener('pointerup', onTouchEnd);
        list.removeEventListener('pointercancel', onTouchCancel);
        list.removeEventListener('pointerdown', onListInteraction);
        list.removeEventListener('wheel', onListInteraction);
        list.removeEventListener('keydown', onListKey);
        range?.removeEventListener('pointerdown', onRangeStart);
        range?.removeEventListener('keydown', onRangeKey);
        window.removeEventListener('pointerup', onRangeEnd, true);
        window.removeEventListener('pointercancel', onRangeEnd, true);
        window.removeEventListener('blur', onRangeEnd);
        document.removeEventListener('visibilitychange', onWindowContextLoss);
        range?.removeEventListener('input', onRange);
        previous?.removeEventListener('click', onPrevious);
        next?.removeEventListener('click', onNext);
        resizeObserver?.disconnect();
        incompleteImageLoadListeners.forEach(({ image, listener }) => {
          image.removeEventListener('load', listener);
        });
        window.cancelAnimationFrame(scrollFrame);
        window.cancelAnimationFrame(refreshFrame);
        activeAnimation?.kill();
        stopListAnimation();
        media?.revert();
      };
    }, root);

    return () => context.revert();
  }

  function cleanupTimelines(): void {
    cleanups.splice(0).forEach((cleanup) => cleanup());
  }

  document.addEventListener('astro:page-load', initTimelines);
  document.addEventListener('astro:before-swap', cleanupTimelines);
</script>
