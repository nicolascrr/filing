---
/**
 * PageHero — shared headerless image hero (US-14 / US-16 / US-18, V2-11)
 *
 * Headerless image hero, full-width AND fullscreen (breaks out of
 * `--content-max`). A background image fills the hero with
 * `object-fit: cover`; a subtle dark scrim sits behind the centered page
 * title for legibility.
 *
 * Used by the Création, Production and Galerie pages (each page's `<h1>`
 * is this hero title). The home page has its own video hero.
 *
 * V2-11: the hero is now fullscreen (`100svh` with `100vh` fallback) on
 * every breakpoint, matching the home page hero. A scroll cue (downward
 * indicator) sits at the bottom to invite the visitor to scroll.
 *
 * Props:
 *   - `image`: the page-hero background asset (Astro `ImageMetadata`).
 *   - `title`: the centered uppercase page name (already translated).
 *
 * Responsive (mobile-first):
 *   - Height: `100svh` (fullscreen) on all breakpoints.
 *   - Title uses a fluid fullscreen scale (clamp), `text-wrap: balance`.
 *
 * Accessibility:
 *   - The background image is decorative: `alt=""`, `aria-hidden`.
 *   - The page name is a real `<h1>` in the DOM (screen-reader accessible).
 *   - The scroll cue is decorative (`aria-hidden`).
 *   - Menu trigger + Footer come from BaseLayout (not re-added here).
 *     The top chrome menu trigger is inverted to stay legible over the dark hero.
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  /** Background hero image (decorative). */
  image: ImageMetadata;
  /** Centered uppercase page title (from i18n). */
  title: string;
  /** Optional layout override class. */
  class?: string;
}

const { image, title, class: className } = Astro.props;
---

<section class:list={['page-hero', className]} aria-label={title}>
  <!-- Background image (decorative). -->
  <Image
    src={image}
    alt=""
    role="presentation"
    aria-hidden="true"
    widths={[480, 768, 1024, 1440, 1920]}
    sizes="100vw"
    class="page-hero__img"
    loading="eager"
  />

  <!-- Dark gradient scrim for legibility of the white title. -->
  <div class="page-hero__scrim" aria-hidden="true"></div>

  <!-- Centered page title. `data-split` opts it into the SplitText char
       reveal (US-23); above-the-fold, so it plays on load. -->
  <h1 class="page-hero__title" data-split>
    {title}
  </h1>

  <!-- Scroll cue (decorative): a thin downward indicator inviting the
       visitor to scroll past the fullscreen hero. -->
  <div class="page-hero__scroll-cue" aria-hidden="true">
    <span class="page-hero__scroll-cue-line"></span>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    width: 100%;
    /* V2-11: fullscreen on every breakpoint. `100svh` accounts for
       mobile browser chrome; `100vh` is the fallback. */
    height: 100vh;
    min-height: 100vh;
    overflow: hidden;
    background: var(--color-charcoal); /* fallback behind the image */
  }

  /* Override both fallback dimensions together: on mobile this prevents an
     obsolete `100vh` minimum from extending below the small viewport. */
  @supports (height: 100svh) {
    .page-hero {
      height: 100svh;
      min-height: 100svh;
    }
  }

  .page-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .page-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.3) 50%,
      rgba(0, 0, 0, 0.5) 100%
    );
  }

  .page-hero__title {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0 var(--content-padding);
    text-align: center;
    color: var(--color-warm-white);
    font-family: var(--font-heading);
    font-weight: 600;
    /* V2-11: larger fluid scale suited to a fullscreen hero. */
    font-size: clamp(2.75rem, 1.5rem + 5vw, 6rem);
    letter-spacing: clamp(0.08em, 0.3vw, 0.18em);
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* ---- Scroll cue (decorative) ---- */
  .page-hero__scroll-cue {
    position: absolute;
    bottom: clamp(1.5rem, 4vh, 3rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    width: 28px;
    height: 44px;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .page-hero__scroll-cue-line {
    width: 2px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.9) 40%,
      rgba(255, 255, 255, 0.9) 100%
    );
    border-radius: 2px;
    transform-origin: top center;
    animation: page-hero-scroll-cue 1.8s var(--ease-luxury, ease-in-out) infinite;
  }

  @keyframes page-hero-scroll-cue {
    0% {
      transform: scaleY(0);
      transform-origin: top center;
      opacity: 0;
    }
    40% {
      transform: scaleY(1);
      transform-origin: top center;
      opacity: 1;
    }
    60% {
      transform: scaleY(1);
      transform-origin: bottom center;
      opacity: 1;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom center;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero__scroll-cue-line {
      animation: none;
      transform: scaleY(1);
      transform-origin: top center;
      opacity: 0.8;
    }
  }
</style>
